# Keep text files consistent across Windows, macOS, and Linux.
* text=auto eol=lf

# Preserve Windows-native line endings for command scripts.
*.bat text eol=crlf
*.cmd text eol=crlf

# Explicitly mark common binary assets.
*.gif binary
*.ico binary
*.jpeg binary
*.jpg binary
*.png binary
*.webp binary
*.woff binary
*.woff2 binary
