---
import { getLangFromUrl, localizedPath, useTranslations, type Lang } from '@/i18n/ui'
import { resolvedResume } from '@/lib/resume'

import { Icon } from 'astro-pure/user'
import LanguageSwitcher from '@/components/LanguageSwitcher.astro'

interface Props {
  lang?: Lang
  home?: boolean
}

const lang = (Astro.props.lang ?? getLangFromUrl(Astro.url)) as Lang
const home = Astro.props.home ?? false
const t = useTranslations(lang)
const homeHref = localizedPath('/', lang)
const resume = resolvedResume(lang)
const resumeLabel =
  lang === 'en' && resume.fallbackToChinese ? `${t('nav.resume')} · CN` : t('nav.resume')
const resumeAria =
  lang === 'en' && resume.fallbackToChinese
    ? 'Open Chinese résumé PDF in a new tab'
    : t('nav.resumeAria')
const navItems = [
  { label: t('nav.homeProjects'), href: localizedPath('/projects', lang), section: 'projects' },
  { label: t('nav.homeExperience'), href: localizedPath('/experience', lang), section: 'experience' },
  { label: t('nav.homeWriting'), href: localizedPath('/blog', lang), section: 'writing' },
  { label: t('nav.homeAbout'), href: localizedPath('/about', lang), section: 'about' }
]
---

<header-component class:list={['site-header', home && 'site-header--home']} data-home={home}>
  <div class='site-header__bar'>
    <a class='site-header__brand' href={homeHref} aria-label='Ygrowly home'>Ygrowly</a>

    <nav class='site-header__desktop' aria-label={lang === 'en' ? 'Primary navigation' : '主导航'}>
      {
        navItems.map((item) => (
          <a href={item.href} data-section-link={item.section}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class='site-header__actions'>
      <div class='site-header__desktop-actions'>
        <LanguageSwitcher {lang} />
        <span class='site-header__separator' aria-hidden='true'></span>
      </div>

      <button
        id='toggleDarkMode'
        class='site-header__icon-button'
        type='button'
        aria-label={t('nav.toggleDarkMode')}
      >
        <Icon class='theme-icon system' name='computer' />
        <Icon class='theme-icon light' name='sun' />
        <Icon class='theme-icon dark' name='moon' />
      </button>

      <a
        class='site-header__resume site-header__desktop-actions'
        href={resume.href}
        target='_blank'
        rel='noopener noreferrer'
        aria-label={resumeAria}
      >
        {resumeLabel}
        <span aria-hidden='true'>↗</span>
      </a>

      <button
        id='toggleMenu'
        class='site-header__icon-button site-header__menu-button'
        type='button'
        aria-controls='mobileMenu'
        aria-expanded='false'
        aria-label={t('nav.openMenu')}
        data-open-label={t('nav.openMenu')}
        data-close-label={t('nav.closeMenu')}
      >
        <Icon class='menu-icon' name='menu' />
        <span class='close-icon' aria-hidden='true'>×</span>
      </button>
    </div>
  </div>

  <div id='mobileMenu' class='site-header__mobile-layer' aria-hidden='true'>
    <button class='site-header__scrim' type='button' tabindex='-1' aria-label={t('nav.closeMenu')}>
    </button>
    <nav
      class='site-header__mobile-menu'
      aria-label={lang === 'en' ? 'Mobile navigation' : '移动导航'}
    >
      {
        navItems.map((item) => (
          <a href={item.href} data-section-link={item.section}>
            {item.label}
          </a>
        ))
      }
      <div class='site-header__mobile-language'>
        <span>{lang === 'en' ? 'Language' : '语言'}</span>
        <LanguageSwitcher {lang} />
      </div>
      <a
        class='site-header__mobile-resume'
        href={resume.href}
        target='_blank'
        rel='noopener noreferrer'
        aria-label={resumeAria}
      >
        {resumeLabel}
        <span aria-hidden='true'>↗</span>
      </a>
    </nav>
  </div>
</header-component>

<script is:inline>
  const initialThemeButton = document.querySelector('header-component #toggleDarkMode')
  if (initialThemeButton instanceof HTMLElement) {
    initialThemeButton.dataset.theme = localStorage.getItem('theme') || 'system'
  }
</script>

<script>
  import { getMobileMenuState, getTheaterHeaderState, nextMobileMenuExpanded } from '@/lib/home-ui'

  import { setTheme } from 'astro-pure/utils'

  class SiteHeader extends HTMLElement {
    private menuButton: HTMLButtonElement | null = null
    private mobileLayer: HTMLElement | null = null
    private sectionObserver: IntersectionObserver | null = null
    private theaterObserver: IntersectionObserver | null = null
    private lastScrollY = 0

    private setMenuExpanded(expanded: boolean) {
      if (!this.menuButton || !this.mobileLayer) return
      const state = getMobileMenuState(expanded, {
        open: this.menuButton.dataset.openLabel ?? 'Open menu',
        close: this.menuButton.dataset.closeLabel ?? 'Close menu'
      })
      this.classList.toggle('is-menu-open', state.expanded)
      this.menuButton.setAttribute('aria-expanded', state.ariaExpanded)
      this.menuButton.setAttribute('aria-label', state.buttonLabel)
      this.mobileLayer.setAttribute('aria-hidden', state.ariaHidden)
      document.documentElement.classList.toggle('mobile-menu-open', state.locksDocument)

      if (state.expanded) {
        window.requestAnimationFrame(() => {
          this.mobileLayer?.querySelector<HTMLAnchorElement>('a')?.focus()
        })
      } else if (document.activeElement && this.mobileLayer.contains(document.activeElement)) {
        this.menuButton.focus()
      }
    }

    private updateScrolledState = () => {
      this.lastScrollY = window.scrollY
      this.classList.toggle('is-scrolled', this.lastScrollY > 24)
    }

    private handleKeydown = (event: KeyboardEvent) => {
      if (event.key === 'Escape' && this.classList.contains('is-menu-open')) {
        event.preventDefault()
        this.setMenuExpanded(nextMobileMenuExpanded(true, 'escape'))
      }
    }

    connectedCallback() {
      this.menuButton = this.querySelector<HTMLButtonElement>('#toggleMenu')
      this.mobileLayer = this.querySelector<HTMLElement>('#mobileMenu')
      this.updateScrolledState()

      this.menuButton?.addEventListener('click', () => {
        this.setMenuExpanded(
          nextMobileMenuExpanded(this.classList.contains('is-menu-open'), 'toggle')
        )
      })
      this.querySelector('.site-header__scrim')?.addEventListener('click', () => {
        this.setMenuExpanded(nextMobileMenuExpanded(true, 'scrim'))
      })
      this.mobileLayer?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          this.setMenuExpanded(nextMobileMenuExpanded(true, 'link'))
        })
      })
      this.querySelector<HTMLButtonElement>('#toggleDarkMode')?.addEventListener(
        'click',
        (event) => {
          const button = event.currentTarget as HTMLButtonElement
          button.dataset.theme = setTheme(undefined, true)
          document.documentElement.dataset.theme = document.documentElement.classList.contains(
            'dark'
          )
            ? 'dark'
            : 'light'
          window.dispatchEvent(new CustomEvent('ygrowly:theme-change'))
        }
      )

      window.addEventListener('scroll', this.updateScrolledState, { passive: true })
      document.addEventListener('keydown', this.handleKeydown)

      const sections = ['projects', 'experience', 'writing']
        .map((id) => document.getElementById(id))
        .filter((section): section is HTMLElement => section !== null)
      if (sections.length > 0) {
        this.sectionObserver = new IntersectionObserver(
          (entries) => {
            const visible = entries
              .filter((entry) => entry.isIntersecting)
              .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0]
            if (!visible) return
            this.querySelectorAll('[data-section-link]').forEach((link) => {
              link.toggleAttribute(
                'data-current',
                link.getAttribute('data-section-link') === visible.target.id
              )
            })
          },
          { rootMargin: '-28% 0px -58% 0px', threshold: [0, 0.1, 0.5] }
        )
        sections.forEach((section) => this.sectionObserver?.observe(section))
      }

      const theater = document.getElementById('projects')
      if (theater) {
        this.theaterObserver = new IntersectionObserver(
          ([entry]) => {
            const state = getTheaterHeaderState(entry.isIntersecting)
            this.toggleAttribute(state.attribute, state.enabled)
          },
          { rootMargin: '-72px 0px -80% 0px', threshold: 0 }
        )
        this.theaterObserver.observe(theater)
      }
    }

    disconnectedCallback() {
      window.removeEventListener('scroll', this.updateScrolledState)
      document.removeEventListener('keydown', this.handleKeydown)
      this.sectionObserver?.disconnect()
      this.theaterObserver?.disconnect()
      document.documentElement.classList.remove('mobile-menu-open')
    }
  }

  if (!customElements.get('header-component')) {
    customElements.define('header-component', SiteHeader)
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 70;
    display: block;
    width: 100%;
    height: 72px;
    color: var(--text-primary);
    transition:
      color 150ms ease,
      background-color 150ms ease,
      border-color 150ms ease;
  }

  .site-header.is-scrolled {
    border-bottom: 1px solid var(--border-default);
    background: color-mix(in srgb, var(--bg-page) 88%, transparent);
    backdrop-filter: blur(12px);
  }

  .site-header[data-over-theater] {
    color: #f3f5f1;
  }

  .site-header[data-over-theater].is-scrolled {
    border-bottom-color: #26312c;
    background: rgba(9, 12, 11, 0.88);
  }

  .site-header__bar {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    width: min(1200px, calc(100% - 64px));
    height: 100%;
    margin: 0 auto;
  }

  .site-header__brand {
    justify-self: start;
    color: inherit;
    font-size: var(--text-xl);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .site-header__desktop {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    height: 100%;
  }

  .site-header__desktop a {
    position: relative;
    display: grid;
    height: 100%;
    align-items: center;
    color: inherit;
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .site-header__desktop a::after {
    position: absolute;
    right: 0;
    bottom: 18px;
    left: 0;
    height: 2px;
    content: '';
    background: currentColor;
    opacity: 0;
    transform: scaleX(0.4);
    transition:
      opacity 180ms ease,
      transform 180ms ease;
  }

  .site-header__desktop a:hover::after,
  .site-header__desktop a[data-current]::after {
    opacity: 1;
    transform: scaleX(1);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    justify-self: end;
    gap: var(--space-3);
  }

  .site-header__desktop-actions {
    display: flex;
    align-items: center;
  }

  .site-header__separator {
    width: 1px;
    height: 18px;
    margin-left: var(--space-3);
    background: currentColor;
    opacity: 0.24;
  }

  .site-header__icon-button {
    position: relative;
    display: grid;
    width: 44px;
    height: 44px;
    padding: 0;
    place-items: center;
    border: 0;
    border-radius: var(--radius-sm);
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  .site-header__icon-button:hover {
    background: color-mix(in srgb, currentColor 8%, transparent);
  }

  .theme-icon {
    position: absolute;
    width: 20px;
    height: 20px;
    opacity: 0;
    transform: scale(0.75);
    transition:
      opacity 150ms ease,
      transform 150ms ease;
  }

  #toggleDarkMode[data-theme='system'] .theme-icon.system,
  #toggleDarkMode:not([data-theme]) .theme-icon.system,
  #toggleDarkMode[data-theme='light'] .theme-icon.light,
  #toggleDarkMode[data-theme='dark'] .theme-icon.dark {
    opacity: 1;
    transform: scale(1);
  }

  .site-header__resume {
    min-height: 44px;
    padding: 0 var(--space-4);
    border-radius: var(--radius-sm);
    background: var(--signal-accent);
    color: #fff;
    font-size: var(--text-sm);
    font-weight: 600;
    line-height: 44px;
    white-space: nowrap;
  }

  .site-header__resume:hover {
    background: var(--signal-accent-hover);
    color: #fff;
  }

  .site-header[data-over-theater] .site-header__resume {
    background: #67e2b7;
    color: #090c0b;
  }

  .site-header__menu-button,
  .site-header__mobile-layer {
    display: none;
  }

  .close-icon {
    display: none;
    font-size: 28px;
    font-weight: 300;
    line-height: 1;
  }

  @media (max-width: 767px) {
    .site-header {
      height: 64px;
    }

    .site-header__bar {
      grid-template-columns: 1fr auto;
      width: calc(100% - 40px);
    }

    .site-header__desktop,
    .site-header__desktop-actions {
      display: none;
    }

    .site-header__menu-button {
      display: grid;
    }

    .site-header__mobile-layer {
      position: fixed;
      inset: 64px 0 0;
      z-index: 1;
      display: block;
      visibility: hidden;
      opacity: 0;
      transition:
        opacity 180ms ease,
        visibility 180ms ease;
    }

    .site-header.is-menu-open .site-header__mobile-layer {
      visibility: visible;
      opacity: 1;
    }

    .site-header__scrim {
      position: absolute;
      inset: 0;
      width: 100%;
      border: 0;
      background: rgba(9, 12, 11, 0.42);
      cursor: default;
    }

    .site-header__mobile-menu {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 0;
      max-height: calc(100svh - 80px);
      margin: 0 var(--space-4);
      padding: var(--space-4);
      overflow-y: auto;
      border: 1px solid var(--border-default);
      border-radius: var(--radius-md);
      background: var(--bg-elevated);
      box-shadow: var(--shadow-menu);
      color: var(--text-primary);
    }

    .site-header__mobile-menu > a,
    .site-header__mobile-language {
      display: flex;
      min-height: 52px;
      align-items: center;
      justify-content: space-between;
      padding: 0 var(--space-3);
      border-bottom: 1px solid var(--border-default);
      color: inherit;
      font-size: var(--text-lg);
      font-weight: 500;
    }

    .site-header__mobile-language :global(.toggle-lang) {
      width: 44px;
      height: 44px;
      padding: 0;
      border: 0;
    }

    .site-header__mobile-menu .site-header__mobile-resume {
      justify-content: center;
      min-height: 48px;
      margin-top: var(--space-4);
      border: 0;
      border-radius: var(--radius-sm);
      background: var(--signal-accent);
      color: #fff;
      font-size: var(--text-base);
      font-weight: 600;
    }

    .site-header.is-menu-open .menu-icon {
      display: none;
    }

    .site-header.is-menu-open .close-icon {
      display: block;
    }
  }

  :global(html.mobile-menu-open) {
    overflow: hidden;
  }
</style>
