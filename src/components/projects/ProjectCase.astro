---
import type { HomeProject } from '@/data/home'
import type { Lang } from '@/i18n/ui'

import BaseLayout from '@/layouts/BaseLayout.astro'

interface Props {
  lang: Lang
  project: HomeProject
}

const { lang, project } = Astro.props
const projectsHref = lang === 'en' ? '/en#projects' : '/#projects'
---

<BaseLayout
  meta={{
    title: `${project.name} | Ygrowly`,
    description: project.summary
  }}
>
  <main class='project-case'>
    <a class='project-case__back' href={projectsHref}>
      {lang === 'en' ? '← Back to selected systems' : '← 返回精选项目'}
    </a>
    <header>
      <p>{project.eyebrow}</p>
      <h1>{project.name}</h1>
      {
        project.slug === 'ai-bi-platform' && lang === 'en' && (
          <span class='project-case__original-name'>Original name: 数驭穹图</span>
        )
      }
      <h2>{project.title}</h2>
      <p class='project-case__summary'>{project.summary}</p>
    </header>

    <section aria-labelledby='role-title'>
      <h2 id='role-title'>{lang === 'en' ? 'Problem & responsibility' : '业务问题与个人职责'}</h2>
      <p>{project.responsibility}</p>
    </section>

    <section aria-labelledby='flow-title'>
      <h2 id='flow-title'>{lang === 'en' ? 'System flow' : '系统链路'}</h2>
      <ol class='project-case__flow'>
        {project.flow.map((step) => <li>{step}</li>)}
      </ol>
    </section>

    <section aria-labelledby='engineering-title'>
      <h2 id='engineering-title'>{lang === 'en' ? 'Engineering focus' : '工程重点'}</h2>
      <dl class='project-case__highlights'>
        {
          project.highlights.map((item) => (
            <div>
              <dt>{item.label}</dt>
              <dd>{item.text}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section aria-labelledby='evidence-title'>
      <h2 id='evidence-title'>{lang === 'en' ? 'Evidence' : '可验证证据'}</h2>
      <dl class='project-case__evidence'>
        {
          project.evidence.map((item) => (
            <div>
              <dt>{item.label}</dt>
              <dd>{item.value}</dd>
            </div>
          ))
        }
      </dl>
      {project.stack && <p class='project-case__stack'>{project.stack}</p>}
    </section>

    <section aria-labelledby='tradeoffs-title'>
      <h2 id='tradeoffs-title'>{lang === 'en' ? 'Design tradeoffs' : '设计取舍'}</h2>
      <ol class='project-case__tradeoffs'>
        {
          project.tradeoffs.map((item) => (
            <li class='project-case__tradeoff'>
              <p class='project-case__decision'>{item.decision}</p>
              <dl>
                <div class='project-case__tradeoff-row'>
                  <dt>{lang === 'en' ? 'Why' : '为什么'}</dt>
                  <dd>{item.why}</dd>
                </div>
                <div class='project-case__tradeoff-row'>
                  <dt>{lang === 'en' ? 'Cost' : '代价'}</dt>
                  <dd>{item.cost}</dd>
                </div>
              </dl>
            </li>
          ))
        }
      </ol>
    </section>

    <section aria-labelledby='scope-title'>
      <h2 id='scope-title'>{lang === 'en' ? 'What this system does not do' : '系统不负责清单'}</h2>
      <p class='project-case__scope-note'>
        {
          lang === 'en'
            ? 'Deliberate non-goals. A boundary that is written down is a boundary that can be held.'
            : '刻意划出的非目标。写下来的边界才是能守住的边界。'
        }
      </p>
      <ul class='project-case__scope'>
        {project.outOfScope.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section aria-labelledby='open-title'>
      <h2 id='open-title'>{lang === 'en' ? 'Open questions' : '开放问题'}</h2>
      <p class='project-case__scope-note'>
        {
          lang === 'en'
            ? 'What I do not have an answer for yet. Happy to be asked about any of these.'
            : '目前还没有答案的部分。欢迎就其中任何一条追问。'
        }
      </p>
      <ul class='project-case__open'>
        {project.openQuestions.map((item) => <li>{item}</li>)}
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  .project-case {
    max-width: 900px;
    margin: 0 auto;
    padding: var(--space-7) 0 var(--space-10);
  }

  .project-case__back {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    color: var(--signal-accent);
    font-size: var(--text-sm);
  }

  header {
    padding: var(--space-8) 0 var(--space-9);
  }

  header > p:first-child,
  .project-case__original-name {
    color: var(--signal-accent);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
  }

  :global(html[lang='en']) header > p:first-child,
  :global(html[lang='en']) .project-case__original-name {
    letter-spacing: 0.08em;
  }

  h1 {
    margin: var(--space-4) 0 0;
    font-size: clamp(48px, 8vw, 84px);
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.2;
  }

  :global(html[lang='en']) h1 {
    letter-spacing: -0.055em;
    line-height: 1;
  }

  header h2 {
    max-width: 760px;
    margin: var(--space-5) 0 0;
    font-size: var(--text-3xl);
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.3;
  }

  :global(html[lang='en']) header h2 {
    letter-spacing: -0.035em;
    line-height: 1.15;
  }

  .project-case__original-name {
    display: block;
    margin-top: var(--space-4);
  }

  .project-case__summary {
    max-width: 720px;
    margin: var(--space-5) 0 0;
    color: var(--text-secondary);
    font-size: var(--text-lg);
  }

  section {
    padding: var(--space-7) 0;
    border-top: 1px solid var(--border-default);
  }

  section > h2 {
    margin: 0 0 var(--space-5);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  :global(html[lang='en']) section > h2 {
    letter-spacing: 0.08em;
  }

  section > p {
    max-width: 720px;
    color: var(--text-secondary);
  }

  .project-case__flow {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .project-case__flow li {
    padding: 10px 12px;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .project-case__highlights,
  .project-case__evidence {
    margin: 0;
  }

  .project-case__highlights > div,
  .project-case__evidence > div {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: var(--space-5);
    padding: var(--space-5) 0;
    border-top: 1px solid var(--border-default);
  }

  dt {
    color: var(--signal-accent);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  dd {
    margin: 0;
    color: var(--text-secondary);
  }

  .project-case__stack {
    color: var(--signal-accent);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .project-case__tradeoffs,
  .project-case__scope,
  .project-case__open {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .project-case__tradeoff {
    padding: var(--space-5) 0;
    border-top: 1px solid var(--border-default);
  }

  .project-case__tradeoff:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .project-case__decision {
    max-width: 720px;
    margin: 0 0 var(--space-3);
    color: var(--text-primary);
    font-size: var(--text-lg);
    font-weight: 600;
    text-wrap: balance;
  }

  .project-case__tradeoff-row {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: var(--space-5);
    padding-top: var(--space-3);
  }

  .project-case__scope-note {
    max-width: 720px;
    margin: 0 0 var(--space-5);
    color: var(--text-tertiary);
    font-size: var(--text-sm);
  }

  .project-case__scope li,
  .project-case__open li {
    position: relative;
    max-width: 720px;
    padding: 0 0 var(--space-3) var(--space-5);
    color: var(--text-secondary);
  }

  .project-case__scope li::before,
  .project-case__open li::before {
    position: absolute;
    left: 0;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .project-case__scope li::before {
    color: var(--text-tertiary);
    content: '×';
  }

  .project-case__open li::before {
    color: var(--signal-accent);
    content: '?';
  }

  @media (max-width: 767px) {
    .project-case {
      padding-top: var(--space-5);
    }

    header {
      padding: var(--space-7) 0 var(--space-8);
    }

    header h2 {
      font-size: var(--text-2xl);
    }

    .project-case__highlights > div,
    .project-case__evidence > div,
    .project-case__tradeoff-row {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }

    .project-case__flow {
      display: grid;
    }
  }
</style>
