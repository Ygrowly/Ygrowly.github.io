---
import type { HomeProject } from '@/data/home'

interface Props {
  project: HomeProject
  index: number
}

const { project, index } = Astro.props
---

<div class='evidence-card'>
  <div class='evidence-card__header'>
    <span>system / 0{index + 1}</span>
    <span class='evidence-card__status'>{project.eyebrow}</span>
  </div>
  <div class='evidence-card__body'>
    <div class='evidence-card__path'>
      {
        project.flow.map((step, stepIndex) => (
          <span>
            {step}
            {stepIndex < project.flow.length - 1 && <i aria-hidden='true'>→</i>}
          </span>
        ))
      }
    </div>
    <dl>
      {
        project.evidence.map((item) => (
          <div>
            <dt>{item.label}</dt>
            <dd>{item.value}</dd>
          </div>
        ))
      }
    </dl>
    {project.stack && <p class='evidence-card__stack'>{project.stack}</p>}
  </div>
</div>

<style>
  .evidence-card {
    width: 100%;
    overflow: hidden;
    border: 1px solid var(--theater-border);
    border-radius: var(--radius-lg);
    background: var(--theater-surface);
  }

  .evidence-card__header {
    display: flex;
    min-height: 48px;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: 0 var(--space-5);
    border-bottom: 1px solid var(--theater-border);
    color: var(--theater-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .evidence-card__status {
    overflow: hidden;
    color: var(--theater-accent);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .evidence-card__body {
    padding: var(--space-6);
  }

  .evidence-card__path {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding: var(--space-5);
    border: 1px solid var(--theater-border);
    border-radius: var(--radius-md);
    background: var(--theater-elevated);
  }

  .evidence-card__path span {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--theater-text);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .evidence-card__path i {
    color: var(--theater-accent);
    font-style: normal;
  }

  .evidence-card dl {
    margin: var(--space-6) 0 0;
  }

  .evidence-card dl > div {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: var(--space-4);
    padding: var(--space-4) 0;
    border-top: 1px solid var(--theater-border);
  }

  .evidence-card dt {
    color: var(--theater-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .evidence-card dd {
    margin: 0;
    color: var(--theater-text);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    word-break: break-word;
  }

  .evidence-card__stack {
    margin: var(--space-5) 0 0;
    color: var(--theater-accent);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1.6;
  }

  @media (max-width: 767px) {
    .evidence-card dl > div {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }

    .evidence-card__header,
    .evidence-card__body {
      padding-right: var(--space-4);
      padding-left: var(--space-4);
    }
  }
</style>
