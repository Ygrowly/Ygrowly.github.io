---
import SectionHead from './SectionHead.astro'

interface Props {
  content: {
    echoCode: string
    echoLabel: string
    echoTitle: string
    echoSub: string
    echoStatus: string
    echoes: { text: string; source: string }[]
  }
}

const { content } = Astro.props
const count = Math.max(1, content.echoes.length)
---

{/*
  Six cross-project evidence lines on a rotating ring: scrolling the chapter
  turns the ring and steps the active card, so the evidence reads as a sequence
  rather than a list.

  Two things differ from the version this replaced. It follows the theme (the
  old one was a hardcoded dark island) and it is 240vh rather than 320vh. Below
  768px, and under prefers-reduced-motion, it lays the same six cards out as a
  plain grid instead of a scroll stage.
*/}
<section
  class='echo-chapter'
  data-echo-section
  aria-labelledby='echo-title'
  style={`--count: ${count}; --step: ${360 / count}deg`}
>
  <div class='echo-chapter__backdrop' aria-hidden='true'></div>

  <div class='echo-stage'>
    <div class='echo-heading'>
      <SectionHead
        id='echo'
        center
        code={content.echoCode}
        label={content.echoLabel}
        title={content.echoTitle}
        status={content.echoStatus}
      />
      <p class='echo-sub'>{content.echoSub}</p>
    </div>

    <div class='echo-ring' data-echo-ring>
      {
        content.echoes.map((echo, index) => (
          <article class:list={['echo-card', index === 0 && 'is-active']} data-echo-card style={`--i: ${index}`}>
            <div class='echo-card__inner'>
              <div class='echo-card__body'>
                <p class='echo-card__text'>{echo.text}</p>
                <p class='echo-card__source'>{echo.source}</p>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <div class='echo-progress' aria-hidden='true'>
      <span data-echo-progress></span>
    </div>
  </div>
</section>

<script>
  import { echoActiveIndex, echoScrollProgress, scrubEase } from '@/lib/home-ui'

  const section = document.querySelector<HTMLElement>('[data-echo-section]')
  if (section) {
    const ring = section.querySelector<HTMLElement>('[data-echo-ring]')
    const bar = section.querySelector<HTMLElement>('[data-echo-progress]')
    const cards = Array.from(section.querySelectorAll<HTMLElement>('[data-echo-card]'))
    const flatQuery = window.matchMedia('(max-width: 767px)')
    const reducedQuery = window.matchMedia('(prefers-reduced-motion: reduce)')

    let activeIndex = -1
    let target = 0
    let current = 0
    let frame = 0
    let last = 0
    let tracking = false
    let isFlat = false

    const setActive = (index: number) => {
      if (index === activeIndex) return
      activeIndex = index
      cards.forEach((card, i) => card.classList.toggle('is-active', i === index))
    }

    const paint = (progress: number) => {
      ring?.style.setProperty('--ring-rot', `${progress * 360}deg`)
      bar?.style.setProperty('--progress', `${progress * 100}%`)
      setActive(echoActiveIndex(progress, cards.length))
    }

    const tick = (now: number) => {
      frame = 0
      const ease = scrubEase((now - last) / 1000)
      last = now
      current += (target - current) * ease
      if (Math.abs(target - current) < 0.0005) current = target
      paint(current)
      if (current !== target) frame = requestAnimationFrame(tick)
    }

    const schedule = () => {
      const rect = section.getBoundingClientRect()
      target = echoScrollProgress(rect.top, rect.height, window.innerHeight)
      if (!frame) {
        last = performance.now()
        frame = requestAnimationFrame(tick)
      }
    }

    const start = () => {
      if (tracking || isFlat) return
      tracking = true
      window.addEventListener('scroll', schedule, { passive: true })
      window.addEventListener('resize', schedule)
      schedule()
    }

    const stop = () => {
      if (!tracking) return
      tracking = false
      window.removeEventListener('scroll', schedule)
      window.removeEventListener('resize', schedule)
    }

    /**
     * Flat mode is the whole fallback: no ring, no scroll stage, the same six
     * cards as a grid in normal document flow. It is also what the ring needs
     * to be for a reader who asked for reduced motion.
     */
    const applyMode = () => {
      const flat = reducedQuery.matches || flatQuery.matches
      if (flat === isFlat) return
      isFlat = flat
      section.classList.toggle('is-flat', flat)
      if (flat) {
        stop()
        // Every card is readable in flow, so nothing may stay dimmed.
        cards.forEach((card) => card.classList.add('is-active'))
      } else {
        activeIndex = -1
        paint(0)
        start()
      }
    }

    // Only pay for scroll work while the chapter is anywhere near the viewport.
    new IntersectionObserver(
      ([entry]) => (entry.isIntersecting ? start() : stop()),
      { rootMargin: '100% 0px' }
    ).observe(section)

    flatQuery.addEventListener('change', applyMode)
    reducedQuery.addEventListener('change', applyMode)
    applyMode()
  }
</script>

<style>
  .echo-chapter {
    position: relative;
    /* A full turn spans this, less one viewport of sticky stage: at 240vh each
       of six cards gets roughly 230px of travel. */
    height: 240vh;
    border-top: 1px solid var(--border-default);
    background: var(--bg-page);
    color: var(--text-primary);
    overflow: clip;
  }

  /* Same grid idiom as the hero and the system map: one deck, one backdrop. */
  .echo-chapter__backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      radial-gradient(
        900px 520px at 50% 46%,
        color-mix(in srgb, var(--tech-glow) 7%, transparent),
        transparent 72%
      ),
      linear-gradient(var(--grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
    background-size:
      auto,
      56px 56px,
      56px 56px;
    mask-image: radial-gradient(120% 85% at 50% 45%, black 34%, transparent 80%);
    pointer-events: none;
  }

  .echo-stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    perspective: 1100px;
    perspective-origin: 50% 50%;
  }

  .echo-heading {
    position: absolute;
    top: clamp(56px, 11vh, 96px);
    right: 0;
    left: 0;
    z-index: 3;
    text-align: center;
  }

  .echo-sub {
    max-width: 560px;
    margin: var(--space-3) auto 0;
    color: var(--text-secondary);
    font-size: var(--text-base);
  }

  .echo-ring {
    position: absolute;
    inset: 0;
    transform: rotateY(var(--ring-rot, 0deg));
    transform-style: preserve-3d;
    will-change: transform;
  }

  .echo-card {
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(480px, 76vw);
    translate: -50% -50%;
    transform: rotateY(calc(var(--i) * var(--step))) translateZ(min(46vw, 560px));
    transform-style: preserve-3d;
    pointer-events: none;
  }

  .echo-card__inner {
    /* Billboard: counter-rotate so the card always faces the viewer. */
    transform: rotateY(calc(-1 * var(--ring-rot) - var(--i) * var(--step)));
    transform-style: preserve-3d;
  }

  /* Dim/blur live on the innermost body — opacity/filter on the 3D layers would
     force transform-style to flat and break the billboard. */
  .echo-card__body {
    padding: var(--space-6) var(--space-6) var(--space-5);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--bg-elevated) 72%, transparent);
    backdrop-filter: blur(6px);
    box-shadow: 0 0 60px -18px color-mix(in srgb, var(--tech-glow) 45%, transparent);
    /* The neighbours are meant to be sensed as a ring, not read: at 0.25 with a
       1px blur their text was legible enough to compete with the front card. */
    opacity: 0.16;
    filter: blur(2px);
    transition:
      opacity 300ms ease,
      filter 300ms ease;
  }

  .echo-card.is-active .echo-card__body {
    opacity: 1;
    filter: none;
  }

  .echo-card__text {
    margin: 0;
    color: var(--text-primary);
    font-size: clamp(17px, 1.6vw, 21px);
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1.55;
  }

  :global(html[lang='en']) .echo-card__text {
    letter-spacing: -0.01em;
  }

  .echo-card__source {
    margin: var(--space-4) 0 0;
    color: var(--tech-accent);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
  }

  :global(html[lang='en']) .echo-card__source {
    letter-spacing: 0.06em;
  }

  .echo-progress {
    position: absolute;
    bottom: clamp(28px, 5vh, 48px);
    left: 50%;
    z-index: 3;
    width: min(240px, 40vw);
    height: 2px;
    translate: -50% 0;
    overflow: hidden;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--border-strong) 70%, transparent);
  }

  .echo-progress span {
    display: block;
    width: var(--progress, 0%);
    height: 100%;
    border-radius: var(--radius-pill);
    background: var(--signal-accent);
  }

  /* Flat mode: no ring, no sticky stage, the six cards in normal flow. Used by
     the script for narrow viewports and reduced motion alike. */
  .echo-chapter.is-flat {
    height: auto;
    padding: var(--space-9) 0;
  }

  .echo-chapter.is-flat .echo-stage {
    position: static;
    height: auto;
    overflow: visible;
    perspective: none;
  }

  .echo-chapter.is-flat .echo-heading {
    position: static;
  }

  .echo-chapter.is-flat .echo-ring {
    position: static;
    display: grid;
    width: min(1200px, calc(100% - 64px));
    margin: var(--space-7) auto 0;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: var(--border-default);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transform: none;
    transform-style: flat;
  }

  .echo-chapter.is-flat .echo-card {
    position: static;
    display: flex;
    width: auto;
    min-width: 0;
    translate: none;
    transform: none;
    opacity: 1;
  }

  .echo-chapter.is-flat .echo-card__inner,
  .echo-chapter.is-flat .echo-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: space-between;
    width: 100%;
    transform: none;
    transform-style: flat;
    border: 0;
    border-radius: 0;
    background: var(--bg-elevated);
    box-shadow: none;
    backdrop-filter: none;
  }

  .echo-chapter.is-flat .echo-progress {
    display: none;
  }

  @media (max-width: 767px) {
    .echo-chapter.is-flat .echo-ring {
      width: calc(100% - 40px);
      grid-template-columns: 1fr;
    }
  }
</style>
