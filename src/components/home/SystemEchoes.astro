---
import SectionHead from './SectionHead.astro'

interface Props {
  content: {
    echoCode: string
    echoLabel: string
    echoTitle: string
    echoSub: string
    echoStatus: string
    echoes: { text: string; source: string }[]
  }
}

const { content } = Astro.props
---

{/*
  Six cross-project evidence lines. They used to be a 6-card deck rotated on a
  CSS ring inside a 320vh scroll stage, with a starfield behind it; the same six
  sentences fit here in under one screen, and the section no longer sits between
  a reader and the contact details.
*/}
<section class='echo-strip' data-echo-strip aria-labelledby='echo-title'>
  <div class='echo-strip__inner'>
    <SectionHead
      id='echo'
      code={content.echoCode}
      label={content.echoLabel}
      title={content.echoTitle}
      status={content.echoStatus}
    />
    <p class='echo-strip__sub'>{content.echoSub}</p>

    <ul class='echo-strip__grid'>
      {
        content.echoes.map((echo, index) => (
          <li class='echo-item' style={`--i: ${index}`}>
            <p class='echo-item__text'>{echo.text}</p>
            <p class='echo-item__source'>{echo.source}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  // One reveal for the group, stagger carried by --i. Motion here is hierarchy:
  // it marks the band as a set of equal-weight evidence lines arriving together.
  const strip = document.querySelector<HTMLElement>('[data-echo-strip]')
  if (strip) {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      strip.classList.add('is-visible')
    } else {
      const observer = new IntersectionObserver(
        ([entry]) => {
          if (!entry.isIntersecting) return
          strip.classList.add('is-visible')
          observer.disconnect()
        },
        { rootMargin: '0px 0px -15% 0px' }
      )
      observer.observe(strip)
    }
  }
</script>

<style>
  .echo-strip {
    padding: var(--space-9) 0;
    border-top: 1px solid var(--border-default);
  }

  .echo-strip__inner {
    width: min(1200px, calc(100% - 64px));
    margin: 0 auto;
  }

  .echo-strip__sub {
    max-width: 560px;
    margin: var(--space-3) 0 0;
    color: var(--text-secondary);
    font-size: var(--text-base);
  }

  .echo-strip__grid {
    display: grid;
    margin: var(--space-7) 0 0;
    padding: 0;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: var(--border-default);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-lg);
    overflow: hidden;
    list-style: none;
  }

  .echo-item {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-5) var(--space-5) var(--space-4);
    background: var(--bg-elevated);
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 420ms ease,
      transform 420ms ease;
    transition-delay: calc(var(--i) * 55ms);
  }

  .echo-strip.is-visible .echo-item {
    opacity: 1;
    transform: none;
  }

  .echo-item__text {
    margin: 0;
    color: var(--text-primary);
    font-size: var(--text-base);
    line-height: 1.65;
  }

  :global(html[lang='en']) .echo-item__text {
    letter-spacing: -0.005em;
  }

  .echo-item__source {
    margin: 0;
    color: var(--tech-accent);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
  }

  :global(html[lang='en']) .echo-item__source {
    letter-spacing: 0.07em;
  }

  @media (prefers-reduced-motion: reduce) {
    .echo-item {
      transition: none;
    }
  }

  @media (max-width: 767px) {
    .echo-strip {
      padding: var(--space-8) 0;
    }

    .echo-strip__inner {
      width: calc(100% - 40px);
    }

    .echo-strip__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
