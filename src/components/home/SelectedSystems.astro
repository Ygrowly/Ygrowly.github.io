---
import type { HomeProject } from '@/data/home'
import { projectHref } from '@/data/home'
import type { Lang } from '@/i18n/ui'

import ProjectEvidence from './ProjectEvidence.astro'
import SectionHead from './SectionHead.astro'

interface Props {
  lang: Lang
  code: string
  label: string
  status: string
  title: string
  projects: HomeProject[]
}

const { lang, code, label, status, title, projects } = Astro.props
---

<systems-theater id='projects' class='project-theater' aria-labelledby='projects-title'>
  <div class='systems-container'>
    <SectionHead id='projects' {code} {label} {title} {status} />

    <div class='systems-stage'>
      <div class='systems-narratives'>
        {
          projects.map((project, index) => (
            <article class='system-narrative' data-system-narrative={index}>
              <p class='system-index'>
                0{index + 1}
                <span aria-hidden='true'>/ 0{projects.length}</span>
              </p>
              <p class='system-eyebrow'>{project.eyebrow}</p>
              <h3>
                <span>{project.name}</span>
                {project.title}
              </h3>
              <p class='system-summary'>{project.summary}</p>

              {/*
                Responsibility, the flow and the highlights all live on the
                case page; the flow and the evidence numbers are already in the
                panel beside this column. What stays here is the part a
                homepage owes: what it is, and a way in.
              */}

              <div class='system-mobile-evidence'>
                <ProjectEvidence project={project} index={index} />
              </div>

              <a class='system-cta' href={projectHref(project.slug, lang)}>
                {project.cta}
              </a>
            </article>
          ))
        }
      </div>

      <div class='systems-evidence' aria-hidden='true'>
        <div class='systems-evidence-frame'>
          <i class='systems-evidence-corner systems-evidence-corner--tl'></i>
          <i class='systems-evidence-corner systems-evidence-corner--tr'></i>
          <i class='systems-evidence-corner systems-evidence-corner--bl'></i>
          <i class='systems-evidence-corner systems-evidence-corner--br'></i>
          <div class='systems-evidence-stack'>
            {
              projects.map((project, index) => (
                <div
                  class:list={['systems-evidence-panel', index === 0 && 'is-active']}
                  data-system-evidence={index}
                >
                  <ProjectEvidence project={project} index={index} />
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</systems-theater>

<script>
  class SystemsTheater extends HTMLElement {
    private observer: IntersectionObserver | null = null
    private media: MediaQueryList | null = null

    private activate(index: string) {
      this.querySelectorAll<HTMLElement>('[data-system-evidence]').forEach((panel) => {
        panel.classList.toggle('is-active', panel.dataset.systemEvidence === index)
      })
    }

    private mountObserver = () => {
      this.observer?.disconnect()
      if (!this.media?.matches) return

      this.observer = new IntersectionObserver(
        (entries) => {
          const active = entries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0]
          if (active instanceof IntersectionObserverEntry) {
            const target = active.target as HTMLElement
            this.activate(target.dataset.systemNarrative ?? '0')
          }
        },
        { rootMargin: '-35% 0px -35% 0px', threshold: [0, 0.15, 0.5] }
      )

      this.querySelectorAll('[data-system-narrative]').forEach((narrative) => {
        this.observer?.observe(narrative)
      })
    }

    connectedCallback() {
      this.media = window.matchMedia('(min-width: 1024px)')
      this.media.addEventListener('change', this.mountObserver)
      this.mountObserver()
    }

    disconnectedCallback() {
      this.observer?.disconnect()
      this.media?.removeEventListener('change', this.mountObserver)
    }
  }

  if (!customElements.get('systems-theater')) {
    customElements.define('systems-theater', SystemsTheater)
  }
</script>

<style>
  .project-theater {
    display: block;
    padding: 128px 0;
    background: var(--theater-bg, #070b16);
    color: var(--theater-text, #eef2fa);
    --theater-bg: #070b16;
    --theater-surface: #0d1424;
    --theater-elevated: #121b30;
    --theater-text: #eef2fa;
    --theater-muted: #93a2bd;
    --theater-border: #1c2a42;
    --theater-accent: #22d3ee;
    --theater-accent-soft: #0c2438;
    /* Re-ink the shared module header for the dark theater. */
    --mh-ink: #eef2fa;
    --mh-muted: #93a2bd;
    --mh-accent: #22d3ee;
    --mh-line: #1c2a42;
  }

  .systems-container {
    width: min(1200px, calc(100% - 64px));
    margin: 0 auto;
  }

  .system-index,
  .system-eyebrow {
    margin: 0;
    color: var(--theater-accent);
    font-family: var(--font-mono);
    font-size: 14px;
    letter-spacing: 0.06em;
    line-height: 1.35;
  }

  :global(html[lang='en']) .system-index,
  :global(html[lang='en']) .system-eyebrow {
    letter-spacing: 0.1em;
  }

  .system-index {
    color: var(--theater-muted);
  }

  .system-index span {
    opacity: 0.55;
  }

  .systems-stage {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--space-5);
    margin-top: var(--space-9);
  }

  .systems-narratives {
    grid-column: span 7;
  }

  .system-narrative {
    display: flex;
    /* Each project still gets its own scene for the sticky panel beside it, but
       that panel carries the spec (flow, numbers, stack). The column only has
       to hold the name, what it is and the way in, so a full viewport each was
       mostly empty. */
    min-height: 48vh;
    flex-direction: column;
    justify-content: center;
    padding: var(--space-7) 0;
  }

  .system-eyebrow {
    margin-top: var(--space-5);
    font-size: var(--text-xs);
  }

  .system-narrative h3 {
    margin: var(--space-4) 0 0;
    font-size: clamp(38px, 4.4vw, 64px);
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.2;
  }

  :global(html[lang='en']) .system-narrative h3 {
    letter-spacing: -0.05em;
    line-height: 1.05;
  }

  .system-narrative h3 span {
    display: block;
    margin-bottom: var(--space-3);
    color: var(--theater-accent);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: 0.04em;
  }

  :global(html[lang='en']) .system-narrative h3 span {
    letter-spacing: 0.06em;
  }

  .system-summary {
    max-width: 640px;
    margin: var(--space-5) 0 0;
    color: var(--theater-muted);
    font-size: var(--text-lg);
    line-height: 1.65;
  }

  .system-cta {
    width: fit-content;
    min-height: 44px;
    margin-top: var(--space-6);
    color: var(--theater-accent);
    font-weight: 600;
    line-height: 44px;
    transition:
      color 180ms ease,
      text-shadow 180ms ease;
  }

  .system-cta:hover {
    color: color-mix(in srgb, var(--theater-accent) 78%, white);
    text-shadow: 0 0 24px color-mix(in srgb, var(--theater-accent) 60%, transparent);
  }

  .systems-evidence {
    position: relative;
    grid-column: 8 / span 5;
  }

  .systems-evidence-frame {
    position: sticky;
    top: 112px;
    height: min(620px, calc(100vh - 144px));
    box-shadow: 0 0 72px -28px color-mix(in srgb, var(--theater-accent) 45%, transparent);
  }

  .systems-evidence-corner {
    position: absolute;
    z-index: 2;
    width: 16px;
    height: 16px;
    border-color: var(--theater-accent);
    filter: drop-shadow(0 0 6px color-mix(in srgb, var(--theater-accent) 55%, transparent));
    opacity: 0.8;
  }

  .systems-evidence-corner--tl {
    top: 0;
    left: 0;
    border-top-width: 1px;
    border-top-style: solid;
    border-left-width: 1px;
    border-left-style: solid;
  }

  .systems-evidence-corner--tr {
    top: 0;
    right: 0;
    border-top-width: 1px;
    border-top-style: solid;
    border-right-width: 1px;
    border-right-style: solid;
  }

  .systems-evidence-corner--bl {
    bottom: 0;
    left: 0;
    border-bottom-width: 1px;
    border-bottom-style: solid;
    border-left-width: 1px;
    border-left-style: solid;
  }

  .systems-evidence-corner--br {
    right: 0;
    bottom: 0;
    border-right-width: 1px;
    border-right-style: solid;
    border-bottom-width: 1px;
    border-bottom-style: solid;
  }

  .systems-evidence-stack {
    position: absolute;
    inset: 0;
  }

  .systems-evidence-panel {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 240ms ease;
  }

  .systems-evidence-panel.is-active {
    opacity: 1;
  }

  .system-mobile-evidence {
    display: none;
  }

  @media (max-width: 1023px) {
    .project-theater {
      padding: var(--space-9) 0;
    }

    .systems-container {
      width: calc(100% - 48px);
    }

    .systems-stage {
      display: block;
      margin-top: var(--space-8);
    }

    .system-narrative {
      min-height: 0;
      padding: var(--space-8) 0 0;
    }

    .system-narrative + .system-narrative {
      margin-top: 80px;
      border-top: 1px solid var(--theater-border);
    }

    .systems-evidence {
      display: none;
    }

    .system-mobile-evidence {
      display: block;
      margin-top: var(--space-6);
    }
  }

  @media (max-width: 767px) {
    .project-theater {
      padding: 80px 0;
    }

    .systems-container {
      width: calc(100% - 40px);
    }

    .system-narrative h3 {
      font-size: clamp(36px, 11vw, 50px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .systems-evidence-panel {
      transition: none;
    }
  }
</style>
