---
import type { CollectionEntry } from 'astro:content'
import type { HomeContent } from '@/data/home'
import { localizedPath, type Lang } from '@/i18n/ui'
import { noteHref, postHref } from '@/lib/home-content'

import SectionHead from './SectionHead.astro'

type Post = CollectionEntry<'blog'> | CollectionEntry<'blogEn'>
type Note = CollectionEntry<'notes'> | CollectionEntry<'notesEn'>
type Talk = CollectionEntry<'talks'>

interface Props {
  lang: Lang
  content: HomeContent['writing']
  talksLabel: string
  posts: Post[]
  notes: Note[]
  talks: Talk[]
  featuredReadingTime?: string
}

const { lang, content, talksLabel, posts, notes, talks, featuredReadingTime } = Astro.props
const featured = posts[0]
const secondary = posts[1]
const dateLocale = lang === 'en' ? 'en' : 'zh-CN'
const formatDate = (date: Date) =>
  date.toLocaleDateString(dateLocale, { year: 'numeric', month: 'short', day: 'numeric' })
---

<section id='writing' class='writing-section' aria-labelledby='writing-title'>
  <div class='writing-container'>
    <SectionHead
      id='writing'
      code={content.code}
      label={content.label}
      title={content.title}
      status={content.status}
    />

    <div class='writing-grid'>
      <div class='writing-blog'>
        {
          featured ? (
            <a class='featured-post' href={postHref(featured, lang)}>
              <span>{content.latest}</span>
              <h3>{featured.data.title}</h3>
              <p>{featured.data.description}</p>
              <dl>
                <div>
                  <dt>{lang === 'en' ? 'Published' : '发布'}</dt>
                  <dd>{formatDate(featured.data.publishDate)}</dd>
                </div>
                {featuredReadingTime && (
                  <div>
                    <dt>{lang === 'en' ? 'Reading' : '阅读'}</dt>
                    <dd>{featuredReadingTime}</dd>
                  </div>
                )}
                {featured.data.tags[0] && (
                  <div>
                    <dt>{lang === 'en' ? 'Related' : '关联'}</dt>
                    <dd>{featured.data.tags[0]}</dd>
                  </div>
                )}
              </dl>
            </a>
          ) : (
            <p class='writing-empty'>
              {content.emptyBlog}
              <a href={localizedPath('/notes', lang)}>{lang === 'zh' ? '笔记 →' : 'Notes →'}</a>
            </p>
          )
        }
        {
          secondary && (
            <a class='secondary-post' href={postHref(secondary, lang)}>
              <span>{formatDate(secondary.data.publishDate)}</span>
              <strong>{secondary.data.title}</strong>
              <i aria-hidden='true'>→</i>
            </a>
          )
        }
      </div>

      <div class='writing-notes'>
        <h3>{content.notes}</h3>
        {
          notes.length > 0 ? (
            <ol>
              {notes.map((note) => (
                <li>
                  <a href={noteHref(note, lang)}>
                    <span class='note-entry'>
                      <strong>{note.data.title}</strong>
                      <i class='note-leader' aria-hidden='true' />
                      <time>{formatDate(note.data.updatedDate ?? note.data.date)}</time>
                    </span>
                    {note.data.description && <span class='note-desc'>{note.data.description}</span>}
                  </a>
                </li>
              ))}
            </ol>
          ) : (
            <p class='writing-empty'>
              {content.emptyNotes}
              <a href={localizedPath('/blog', lang)}>{lang === 'zh' ? '博客 →' : 'Blog →'}</a>
            </p>
          )
        }
      </div>
    </div>

    {
      talks.length > 0 && (
        <div class='talks-strip'>
          <h3>{talksLabel}</h3>
          <ol>
            {talks.slice(0, 3).map((talk) => (
              <li>
                <span>{talk.data.status === 'upcoming' ? 'Upcoming' : 'Talk'}</span>
                <strong>{talk.data.title}</strong>
                <time>{formatDate(talk.data.date)}</time>
              </li>
            ))}
          </ol>
        </div>
      )
    }
  </div>
</section>

<style>
  .writing-section {
    padding: var(--space-10) 0;
    background: var(--bg-surface);
    border-block: 1px solid var(--border-default);
  }

  .writing-container {
    width: min(1200px, calc(100% - 64px));
    margin: 0 auto;
  }

  .writing-grid {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .featured-post {
    display: flex;
    min-height: 420px;
    flex-direction: column;
    padding: var(--space-6);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-lg);
    background: var(--bg-elevated);
    color: var(--text-primary);
    transition:
      border-color 180ms cubic-bezier(0.2, 0.8, 0.2, 1),
      transform 240ms cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 240ms ease;
  }

  .featured-post:hover {
    border-color: var(--signal-accent);
    color: var(--text-primary);
    transform: translateY(-4px);
    box-shadow: var(--glow-ring);
  }

  .featured-post > span {
    color: var(--tech-accent);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  :global(html[lang='en']) .featured-post > span {
    letter-spacing: 0.08em;
  }

  .featured-post h3 {
    max-width: 620px;
    margin: var(--space-7) 0 0;
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.2;
  }

  :global(html[lang='en']) .featured-post h3 {
    letter-spacing: -0.045em;
    line-height: 1.1;
  }

  .featured-post > p {
    max-width: 620px;
    margin: var(--space-5) 0 var(--space-6);
    color: var(--text-secondary);
  }

  .featured-post dl {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    margin: auto 0 0;
    padding-top: var(--space-5);
    border-top: 1px dashed var(--border-strong);
  }

  .featured-post dl > div {
    display: flex;
    gap: var(--space-2);
    margin-top: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .featured-post dt {
    color: var(--text-tertiary);
  }

  .featured-post dd {
    margin: 0;
    color: var(--text-secondary);
  }

  .secondary-post {
    display: grid;
    min-height: 72px;
    grid-template-columns: auto 1fr auto;
    gap: var(--space-4);
    align-items: center;
    margin-top: var(--space-4);
    padding: 0 var(--space-4);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    background: var(--bg-elevated);
    color: var(--text-primary);
    transition: border-color 180ms ease;
  }

  .secondary-post:hover {
    border-color: var(--signal-accent);
  }

  .secondary-post span {
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .secondary-post i {
    color: var(--tech-accent);
    font-style: normal;
    transition: transform 180ms ease;
  }

  .secondary-post:hover i {
    transform: translateX(3px);
  }

  .writing-notes {
    padding-left: var(--space-5);
    border-left: 1px solid var(--border-default);
  }

  .writing-notes > h3,
  .talks-strip > h3 {
    margin: 0;
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .writing-notes ol,
  .talks-strip ol {
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
  }

  .writing-notes li {
    border-top: 1px solid var(--border-default);
  }

  .writing-notes li:last-child {
    border-bottom: 1px solid var(--border-default);
  }

  .writing-notes a {
    display: block;
    padding: var(--space-4) 0;
    color: var(--text-primary);
  }

  .note-entry {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    min-width: 0;
  }

  .writing-notes strong {
    font-weight: 600;
    line-height: 1.35;
  }

  /* Ledger leader: dotted run from the title to the date. */
  .note-leader {
    flex: 1;
    min-width: 24px;
    border-bottom: 1px dashed var(--border-strong);
    translate: 0 -3px;
  }

  .writing-notes time {
    flex: none;
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .note-desc {
    display: -webkit-box;
    margin-top: var(--space-2);
    overflow: hidden;
    color: var(--text-secondary);
    font-size: var(--text-sm);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;
  }

  .writing-empty {
    color: var(--text-secondary);
  }

  .talks-strip {
    margin-top: var(--space-8);
    padding-top: var(--space-5);
    border-top: 1px solid var(--border-default);
  }

  .talks-strip ol {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
  }

  .talks-strip li {
    display: grid;
    gap: var(--space-2);
  }

  .talks-strip span,
  .talks-strip time {
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  @media (max-width: 1023px) {
    .writing-section {
      padding: var(--space-9) 0;
    }

    .writing-container {
      width: calc(100% - 48px);
    }

    .writing-grid {
      grid-template-columns: 1fr;
    }

    .writing-notes {
      padding-top: var(--space-6);
      padding-left: 0;
      border-top: 1px solid var(--border-default);
      border-left: 0;
    }
  }

  @media (max-width: 767px) {
    .writing-section {
      padding: 72px 0;
    }

    .writing-container {
      width: calc(100% - 40px);
    }

    .featured-post {
      min-height: 380px;
      padding: var(--space-5);
    }

    .secondary-post {
      grid-template-columns: 1fr auto;
      padding: var(--space-4);
    }

    .secondary-post span {
      grid-column: 1 / -1;
    }

    .note-entry {
      flex-wrap: wrap;
    }

    .note-leader {
      display: none;
    }

    .talks-strip ol {
      grid-template-columns: 1fr;
    }
  }
</style>
