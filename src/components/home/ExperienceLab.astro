---
import type { HomeContent } from '@/data/home'

import SectionHead from './SectionHead.astro'

interface Props {
  experience: HomeContent['experience']
  lab: HomeContent['lab']
}

const { experience, lab } = Astro.props

const statusTone = (status: string) => {
  const key = status.toLowerCase()
  if (key === 'live') return 'ok'
  if (key === 'hackathon') return 'warn'
  return 'accent'
}
---

<section id='experience' class='experience-section' aria-labelledby='experience-title'>
  <div class='experience-container'>
    <SectionHead
      id='experience'
      code={experience.code}
      label={experience.label}
      title={experience.title}
      status={experience.status}
    />

    <div class='experience-list'>
      {
        experience.items.map((item, index) => (
          <article class='experience-row'>
            <time>{item.period}</time>
            <div class='experience-row__identity'>
              <h3>{item.company}</h3>
              <p>{item.role}</p>
            </div>
            <div class='experience-row__work'>
              <p>{item.contribution}</p>
              <p id={`experience-focus-${index}`} class='experience-row__focus' hidden>
                {item.focus}
              </p>
            </div>
            <button
              type='button'
              class='experience-row__toggle'
              aria-controls={`experience-focus-${index}`}
              aria-expanded='false'
              data-expand-label={experience.expand}
              data-collapse-label={experience.collapse}
            >
              <span class='sr-only'>{experience.expand}</span>
              <span aria-hidden='true'>↓</span>
            </button>
          </article>
        ))
      }
    </div>

    <div class='lab-section' aria-labelledby='lab-title'>
      <h2 id='lab-title'>{lab.label}</h2>
      <div class='lab-grid'>
        {
          lab.items.map((item) => (
            <a
              class='lab-card'
              href={item.href}
              target={item.external ? '_blank' : undefined}
              rel={item.external ? 'noopener noreferrer' : undefined}
            >
              <span class='lab-card__status' data-tone={statusTone(item.status)}>
                <i aria-hidden='true' />
                {item.status}
              </span>
              <h3>{item.name}</h3>
              <p>{item.description}</p>
              <i class='lab-card__arrow' aria-hidden='true'>{item.external ? '↗' : '→'}</i>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('click', (event) => {
    const target = event.target
    if (!(target instanceof Element)) return
    const button = target.closest<HTMLButtonElement>('.experience-row__toggle')
    if (!button) return

    const expanded = button.getAttribute('aria-expanded') === 'true'
    const panelId = button.getAttribute('aria-controls')
    const panel = panelId ? document.getElementById(panelId) : null
    if (!panel) return

    button.setAttribute('aria-expanded', String(!expanded))
    panel.hidden = expanded
    const label = expanded ? button.dataset.expandLabel : button.dataset.collapseLabel
    const screenReaderLabel = button.querySelector('.sr-only')
    if (screenReaderLabel && label) screenReaderLabel.textContent = label
  })
</script>

<style>
  .experience-section {
    padding: var(--space-10) 0;
  }

  .experience-container {
    width: min(1200px, calc(100% - 64px));
    margin: 0 auto;
  }

  .experience-list {
    margin-top: var(--space-8);
    border-bottom: 1px solid var(--border-default);
  }

  .experience-row {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--space-5);
    padding: 28px 0;
    border-top: 1px solid var(--border-default);
    transition: background-color 200ms ease;
  }

  /* Log-entry hover: an accent bar slides in along the row's left edge. */
  .experience-row::before {
    position: absolute;
    top: 24px;
    bottom: 24px;
    left: -20px;
    width: 2px;
    background: var(--signal-accent);
    opacity: 0;
    transform: scaleY(0.4);
    transform-origin: top;
    transition:
      opacity 200ms ease,
      transform 240ms cubic-bezier(0.2, 0.8, 0.2, 1);
    content: '';
  }

  .experience-row:hover::before {
    opacity: 1;
    transform: scaleY(1);
  }

  .experience-row time {
    grid-column: span 2;
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
  }

  .experience-row__identity {
    grid-column: span 4;
  }

  .experience-row h3,
  .experience-row p {
    margin: 0;
  }

  .experience-row h3 {
    font-size: var(--text-lg);
    font-weight: 600;
  }

  .experience-row__identity p,
  .experience-row__work {
    color: var(--text-secondary);
    font-size: var(--text-sm);
  }

  .experience-row__identity p {
    margin-top: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .experience-row__work {
    grid-column: span 5;
  }

  .experience-row__focus {
    margin-top: var(--space-4) !important;
    color: var(--text-primary);
  }

  .experience-row__focus[hidden] {
    display: none;
  }

  .experience-row__toggle {
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    justify-self: end;
    border: 0;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--text-secondary);
    cursor: pointer;
    font: inherit;
  }

  .experience-row__toggle span:last-child {
    transition: transform 180ms ease;
  }

  .experience-row__toggle[aria-expanded='true'] span:last-child {
    transform: rotate(180deg);
  }

  .experience-row__toggle:hover {
    color: var(--signal-accent);
  }

  .lab-section {
    margin-top: var(--space-9);
  }

  .lab-section > h2 {
    margin: 0;
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  :global(html[lang='en']) .lab-section > h2 {
    letter-spacing: 0.12em;
  }

  .lab-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-5);
    margin-top: var(--space-5);
  }

  .lab-card {
    position: relative;
    min-width: 0;
    padding: 20px;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    background: var(--bg-surface);
    color: var(--text-primary);
    transition:
      border-color 180ms cubic-bezier(0.2, 0.8, 0.2, 1),
      transform 240ms cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 240ms ease;
  }

  .lab-card:hover {
    border-color: var(--signal-accent);
    color: var(--text-primary);
    transform: translateY(-4px);
    box-shadow: var(--glow-ring);
  }

  /* HUD corner ticks appear while the tile is engaged. */
  .lab-card::before,
  .lab-card::after {
    position: absolute;
    width: 10px;
    height: 10px;
    opacity: 0;
    transition: opacity 200ms ease;
    content: '';
  }

  .lab-card::before {
    top: 6px;
    right: 6px;
    border-top: 1px solid var(--tech-glow);
    border-right: 1px solid var(--tech-glow);
  }

  .lab-card::after {
    bottom: 6px;
    left: 6px;
    border-bottom: 1px solid var(--tech-glow);
    border-left: 1px solid var(--tech-glow);
  }

  .lab-card:hover::before,
  .lab-card:hover::after {
    opacity: 0.9;
  }

  .lab-card__status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
  }

  :global(html[lang='en']) .lab-card__status {
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .lab-card__status i {
    width: 6px;
    height: 6px;
    border-radius: var(--radius-pill);
    background: currentColor;
    box-shadow: 0 0 8px color-mix(in srgb, currentColor 60%, transparent);
  }

  .lab-card__status[data-tone='ok'] {
    color: var(--status-ok);
  }

  .lab-card__status[data-tone='warn'] {
    color: var(--status-warn);
  }

  .lab-card__status[data-tone='accent'] {
    color: var(--tech-accent);
  }

  .lab-card h3 {
    margin: var(--space-3) 0 0;
    font-size: var(--text-xl);
  }

  .lab-card p {
    min-height: 3.3em;
    margin: var(--space-3) var(--space-5) 0 0;
    color: var(--text-secondary);
    font-size: var(--text-sm);
  }

  .lab-card__arrow {
    position: absolute;
    top: 20px;
    right: 20px;
    color: var(--tech-accent);
    font-style: normal;
    transition: transform 180ms ease;
  }

  .lab-card:hover .lab-card__arrow {
    transform: translateX(3px);
  }

  @media (max-width: 1023px) {
    .experience-section {
      padding: var(--space-9) 0;
    }

    .experience-container {
      width: calc(100% - 48px);
    }

    .experience-row::before {
      left: -14px;
    }
  }

  @media (max-width: 767px) {
    .experience-section {
      padding: 72px 0;
    }

    .experience-container {
      width: calc(100% - 40px);
    }

    .experience-row::before {
      display: none;
    }

    .experience-row {
      grid-template-columns: 1fr 44px;
      gap: var(--space-4);
    }

    .experience-row time,
    .experience-row__identity,
    .experience-row__work {
      grid-column: 1;
    }

    .experience-row__toggle {
      grid-row: 1 / span 3;
      grid-column: 2;
    }

    .lab-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
