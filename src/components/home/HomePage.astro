---
import { getCollection, render } from 'astro:content'
import { homeContent } from '@/data/home'
import type { Lang } from '@/i18n/ui'
import { postHref, selectPublishedNotes, selectPublishedPosts } from '@/lib/home-content'

import BaseLayout from '@/layouts/BaseLayout.astro'
import ExperienceLab from '@/components/home/ExperienceLab.astro'
import NightChapter from '@/components/home/NightChapter.astro'
import ProfileContact from '@/components/home/ProfileContact.astro'
import SelectedSystems from '@/components/home/SelectedSystems.astro'
import WritingSection from '@/components/home/WritingSection.astro'
import Terminal from '@/components/terminal/Terminal.astro'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const content = homeContent[lang]
const blogCollection = lang === 'en' ? 'blogEn' : 'blog'
const notesCollection = lang === 'en' ? 'notesEn' : 'notes'
const posts = selectPublishedPosts(await getCollection(blogCollection), lang, 2)
const notes = selectPublishedNotes(await getCollection(notesCollection), lang, 3)
const talks =
  lang === 'zh'
    ? (await getCollection('talks'))
        .filter((talk) => !talk.data.draft && talk.data.date <= new Date())
        .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
        .slice(0, 3)
    : []
const latestPostHref = posts[0] ? postHref(posts[0], lang) : `${lang === 'en' ? '/en' : ''}/blog`
const featuredRender = posts[0] ? await render(posts[0]) : null
const featuredReadingTime = (
  lang === 'zh'
    ? featuredRender?.remarkPluginFrontmatter?.minutesReadZh
    : featuredRender?.remarkPluginFrontmatter?.minutesRead
) as string | undefined
---

<BaseLayout home exactTitle meta={content.meta}>
  <main id='top' class='home-page'>
    <section class='home-hero' aria-labelledby='home-title'>
      <div class='home-hero__backdrop' aria-hidden='true'></div>
      <div class='home-container home-hero__grid'>
        <div class='home-hero__copy'>
          <p class='home-eyebrow'>
            <i class='home-eyebrow__dot' aria-hidden='true'></i>
            {content.hero.eyebrow}
          </p>
          <h1 id='home-title'>{content.hero.title}</h1>
          <p class='home-hero__description'>{content.hero.description}</p>

          <div class='home-hero__actions'>
            <a class='home-button home-button--primary' href='#projects'>
              {content.hero.projects}
            </a>
            <a class='home-button home-button--secondary' href={latestPostHref}>
              {content.hero.writing}
            </a>
          </div>

          <ul class='home-hero__status' aria-label={lang === 'en' ? 'Current status' : '当前状态'}>
            {content.hero.status.map((item) => <li>{item}</li>)}
          </ul>

          <div class='home-hero__recent'>
            <span>{content.hero.recentLabel}</span>
            <ul>
              {content.hero.recent.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        </div>

        <div class='home-hero__terminal-slot' data-terminal-slot>
          <div class='home-hero__tilt' data-hero-tilt>
            <div class='home-hero__hud' aria-hidden='true'>
              <i class='home-hero__hud-corner home-hero__hud-corner--tl'></i>
              <i class='home-hero__hud-corner home-hero__hud-corner--tr'></i>
              <i class='home-hero__hud-corner home-hero__hud-corner--bl'></i>
              <i class='home-hero__hud-corner home-hero__hud-corner--br'></i>
              <span class='home-hero__hud-scan'></span>
            </div>
            <Terminal {lang} />
          </div>
        </div>
      </div>
    </section>

    <SelectedSystems
      {lang}
      code={content.systems.code}
      label={content.systems.label}
      status={content.systems.status}
      title={content.systems.title}
      projects={content.systems.projects}
    />

    <ExperienceLab experience={content.experience} lab={content.lab} />
    <WritingSection
      {lang}
      content={content.writing}
      talksLabel={content.talks.label}
      {posts}
      {notes}
      {talks}
      {featuredReadingTime}
    />
    <NightChapter content={content.night} />
    <ProfileContact
      {lang}
      profile={content.profile}
      contact={content.contact}
      footer={content.footer}
    />
  </main>
</BaseLayout>

<script>
  const slot = document.querySelector<HTMLElement>('[data-terminal-slot]')
  const tilt = document.querySelector<HTMLElement>('[data-hero-tilt]')

  if (
    slot &&
    tilt &&
    window.matchMedia('(hover: hover) and (pointer: fine)').matches &&
    !window.matchMedia('(prefers-reduced-motion: reduce)').matches
  ) {
    const MAX_TILT = 2.5

    const onMove = (event: PointerEvent) => {
      const rect = slot.getBoundingClientRect()
      const px = (event.clientX - rect.left) / rect.width - 0.5
      const py = (event.clientY - rect.top) / rect.height - 0.5
      tilt.style.setProperty('--rx', `${(-py * MAX_TILT).toFixed(2)}deg`)
      tilt.style.setProperty('--ry', `${(px * MAX_TILT).toFixed(2)}deg`)
    }

    const onLeave = () => {
      tilt.style.setProperty('--rx', '0deg')
      tilt.style.setProperty('--ry', '0deg')
    }

    slot.addEventListener('pointermove', onMove)
    slot.addEventListener('pointerleave', onLeave)
  }
</script>

<style>
  .home-page {
    width: 100%;
    overflow: clip;
    background: var(--bg-page);
    color: var(--text-primary);
  }

  .home-container {
    width: min(1200px, calc(100% - 64px));
    margin: 0 auto;
  }

  .home-hero {
    position: relative;
    min-height: max(680px, calc(100svh - 72px));
  }

  .home-hero__backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      radial-gradient(
        720px 420px at 78% 42%,
        color-mix(in srgb, var(--tech-glow) 9%, transparent),
        transparent 70%
      ),
      linear-gradient(var(--grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
    background-size:
      auto,
      56px 56px,
      56px 56px;
    mask-image: radial-gradient(120% 90% at 50% 40%, black 30%, transparent 78%);
    pointer-events: none;
  }

  :global(.dark) .home-hero__backdrop {
    background:
      radial-gradient(
        720px 420px at 78% 42%,
        color-mix(in srgb, var(--tech-glow) 16%, transparent),
        transparent 70%
      ),
      linear-gradient(var(--grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
    background-size:
      auto,
      56px 56px,
      56px 56px;
  }

  .home-hero__grid {
    position: relative;
    z-index: 1;
    display: grid;
    min-height: max(680px, calc(100svh - 72px));
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--space-5);
    align-items: center;
    padding-top: 72px;
    padding-bottom: 72px;
  }

  .home-hero__copy {
    grid-column: span 6;
  }

  .home-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    margin: 0;
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    line-height: 1.35;
  }

  :global(html[lang='en']) .home-eyebrow {
    letter-spacing: 0.12em;
  }

  .home-eyebrow__dot {
    flex: none;
    width: 7px;
    height: 7px;
    border-radius: var(--radius-pill);
    background: var(--status-ok);
    box-shadow: 0 0 8px color-mix(in srgb, var(--status-ok) 70%, transparent);
  }

  .home-hero h1 {
    max-width: 680px;
    margin: 20px 0 0;
    font-size: var(--text-hero);
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.2;
  }

  :global(html[lang='en']) .home-hero h1 {
    letter-spacing: -0.045em;
    line-height: 1.04;
  }

  .home-hero__description {
    max-width: 580px;
    margin: 28px 0 0;
    color: var(--text-secondary);
    font-size: var(--text-lg);
    line-height: 1.65;
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .home-button {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    padding: 0 20px;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    font-weight: 600;
    transition:
      background-color 180ms ease,
      border-color 180ms ease,
      color 180ms ease,
      box-shadow 240ms ease;
  }

  .home-button--primary {
    background: var(--signal-accent);
    color: var(--accent-contrast);
  }

  .home-button--primary:hover {
    background: var(--signal-accent-hover);
    color: var(--accent-contrast);
    box-shadow: 0 0 28px -6px color-mix(in srgb, var(--tech-glow) 60%, transparent);
  }

  .home-button--secondary {
    border-color: var(--border-strong);
    color: var(--text-primary);
  }

  .home-button--secondary:hover {
    border-color: var(--signal-accent);
    color: var(--signal-accent);
    box-shadow: 0 0 24px -10px color-mix(in srgb, var(--tech-glow) 50%, transparent);
  }

  /* Readout bar: the operator's status strip. */
  .home-hero__status {
    display: flex;
    margin: var(--space-7) 0 0;
    border-block: 1px solid var(--border-default);
    padding: 0;
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    list-style: none;
  }

  :global(html[lang='en']) .home-hero__status {
    letter-spacing: 0.06em;
  }

  .home-hero__status li {
    flex: 1 1 0;
    min-width: 0;
    padding: 14px 20px 14px 0;
  }

  .home-hero__status li + li {
    border-left: 1px solid var(--border-default);
    padding-left: 20px;
  }

  .home-hero__status li:last-child {
    color: var(--status-ok);
  }

  .home-hero__status li:last-child::before {
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-right: var(--space-2);
    border-radius: var(--radius-pill);
    background: currentColor;
    box-shadow: 0 0 8px color-mix(in srgb, var(--status-ok) 70%, transparent);
    content: '';
    vertical-align: 1px;
  }

  .home-hero__recent {
    display: grid;
    margin-top: var(--space-5);
    grid-template-columns: auto 1fr;
    gap: var(--space-5);
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
  }

  :global(html[lang='en']) .home-hero__recent {
    letter-spacing: 0.06em;
  }

  .home-hero__recent > span {
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .home-hero__recent ul {
    display: flex;
    flex-wrap: wrap;
    margin: 0;
    padding: 0;
    color: var(--text-secondary);
    list-style: none;
  }

  .home-hero__recent li {
    display: inline-flex;
  }

  .home-hero__recent li + li::before {
    margin: 0 0.9em;
    color: var(--tech-accent);
    content: '/';
  }

  .home-hero__terminal-slot {
    min-width: 0;
    height: 460px;
    grid-column: 8 / span 5;
  }

  .home-hero__tilt {
    position: relative;
    height: 100%;
    transform: perspective(1100px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transform-style: preserve-3d;
    transition: transform 240ms ease-out;
    will-change: transform;
  }

  .home-hero__hud {
    position: absolute;
    inset: -10px;
    z-index: 2;
    overflow: hidden;
    pointer-events: none;
  }

  .home-hero__hud-corner {
    position: absolute;
    width: 18px;
    height: 18px;
    filter: drop-shadow(0 0 6px color-mix(in srgb, var(--tech-glow) 60%, transparent));
    opacity: 0.85;
  }

  .home-hero__hud-corner--tl {
    top: 0;
    left: 0;
    border-top: 1px solid var(--tech-glow);
    border-left: 1px solid var(--tech-glow);
  }

  .home-hero__hud-corner--tr {
    top: 0;
    right: 0;
    border-top: 1px solid var(--tech-glow);
    border-right: 1px solid var(--tech-glow);
  }

  .home-hero__hud-corner--bl {
    bottom: 0;
    left: 0;
    border-bottom: 1px solid var(--tech-glow);
    border-left: 1px solid var(--tech-glow);
  }

  .home-hero__hud-corner--br {
    right: 0;
    bottom: 0;
    border-right: 1px solid var(--tech-glow);
    border-bottom: 1px solid var(--tech-glow);
  }

  .home-hero__hud-scan {
    position: absolute;
    top: -12%;
    right: 0;
    left: 0;
    height: 48px;
    background: linear-gradient(
      to bottom,
      transparent,
      color-mix(in srgb, var(--tech-glow) 10%, transparent) 45%,
      color-mix(in srgb, var(--tech-glow) 14%, transparent) 55%,
      transparent
    );
    animation: hero-scan 7s linear infinite;
  }

  @keyframes hero-scan {
    to {
      transform: translateY(620px);
    }
  }

  @media (max-width: 1023px) {
    .home-container {
      width: calc(100% - 48px);
    }

    .home-hero__grid {
      min-height: auto;
      grid-template-columns: 1fr;
      padding-top: 64px;
      padding-bottom: 88px;
    }

    .home-hero__copy,
    .home-hero__terminal-slot {
      grid-column: 1;
    }

    .home-hero__terminal-slot {
      height: 400px;
      margin-top: var(--space-7);
    }

    .home-hero__status {
      flex-wrap: wrap;
    }

    .home-hero__status li {
      flex: 1 1 40%;
      padding: 12px 16px 12px 0;
    }

    .home-hero__status li:nth-child(odd) {
      border-left: 0;
      padding-left: 0;
    }

    .home-hero__status li:nth-child(n + 3) {
      border-top: 1px solid var(--border-default);
    }
  }

  @media (max-width: 767px) {
    .home-container {
      width: calc(100% - 40px);
    }

    .home-hero__grid {
      padding-top: 48px;
      padding-bottom: 72px;
    }

    .home-hero h1 {
      font-size: clamp(40px, 12vw, 56px);
    }

    .home-hero__description {
      font-size: var(--text-base);
    }

    .home-hero__actions {
      flex-direction: column;
    }

    .home-button {
      width: 100%;
    }

    .home-hero__status {
      flex-direction: column;
    }

    .home-hero__status li {
      flex: none;
      padding: 12px 0;
    }

    .home-hero__status li + li {
      border-top: 1px solid var(--border-default);
      border-left: 0;
      padding-left: 0;
    }

    .home-hero__recent {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }

    .home-hero__terminal-slot {
      height: 320px;
    }
  }
</style>
