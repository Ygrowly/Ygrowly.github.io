---
import { cn } from 'astro-pure/utils'

import { getLangFromUrl } from '@/i18n/ui'

import type { TocItem } from './toc'

interface Props {
  heading: TocItem
}

const {
  heading: { depth, isRoot, slug, subheadings, text: rawText }
} = Astro.props
const text = rawText.endsWith('#') ? rawText.slice(0, -1) : rawText
const lang = getLangFromUrl(Astro.url)
---

<li>
  <div class='relative'>
    <span
      data-toc-progress
      class='absolute top-[5%] w-[2px] rounded transition-colors duration-300 [&.highlight-bg]:bg-primary [&.is-read]:bg-input'
    ></span>
    <a
      data-toc-link
      aria-label={`${lang === 'en' ? 'Scroll to section: ' : '滚动到小节：'}${text}`}
      class={cn(
        'toc-item line-clamp-2 px-3 py-1 ms-2 text-foreground/75 transition-all hover:text-foreground [&.highlight]:font-medium [&.highlight]:text-primary [&.highlight-bg-translucent]:bg-muted',
        depth > 2 ? 'ps-10' : !isRoot ? 'ps-7' : undefined
      )}
      href={`#${slug}`}>{text}</a
    >
  </div>
  {
    !!subheadings.length && (
      <ul>
        {subheadings.map((subheading) => (
          <Astro.self heading={subheading} />
        ))}
      </ul>
    )
  }
</li>

<style>
  .toc-item.is-read {
    color: hsl(var(--muted-foreground) / 0.7);
  }
  [data-toc-progress].is-read {
    background: hsl(var(--muted-foreground) / 0.35);
  }
</style>
