---
import { cn } from 'astro-pure/utils'

import { getLangFromUrl } from '@/i18n/ui'

interface Props {
  class?: string
  path?: string
  hideComment?: boolean
}

const { class: className, path: pathProp, hideComment } = Astro.props as Props

const stripEn = (p: string) => p.replace(/^\/en(?=\/|$)/, '') || '/'
const path = stripEn(pathProp ?? Astro.url.pathname)
const lang = getLangFromUrl(Astro.url)
const isEn = lang === 'en'
---

<div class={cn('text-sm text-muted-foreground', className)}>
  <span class='waline-pageview-count' data-path={path}></span> {isEn ? 'views' : '阅读'}
  {
    !hideComment && (
      <a href='#waline'>
        | <span class='waline-comment-count' data-path={path} /> {isEn ? 'comments' : '评论'}
      </a>
    )
  }
</div>
