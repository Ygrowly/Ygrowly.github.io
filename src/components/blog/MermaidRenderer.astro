<script>
  let diagramId = 0
  let rendering = false

  function getThemeVariables() {
    const styles = getComputedStyle(document.documentElement)
    const readToken = (name: string, fallback: string) =>
      styles.getPropertyValue(name).trim() || fallback

    return {
      background: readToken('--bg-page', '#ffffff'),
      primaryColor: readToken('--accent-soft', '#eff6ff'),
      primaryTextColor: readToken('--text-primary', '#18181b'),
      primaryBorderColor: readToken('--signal-accent', '#1d4ed8'),
      lineColor: readToken('--signal-accent', '#1d4ed8'),
      secondaryColor: readToken('--bg-elevated', '#ffffff'),
      tertiaryColor: readToken('--bg-surface', '#f8fafc'),
      nodeTextColor: readToken('--text-primary', '#18181b'),
      clusterBkg: readToken('--bg-surface', '#f8fafc'),
      clusterBorder: readToken('--border-default', '#e4e4e7'),
      titleColor: readToken('--text-primary', '#18181b'),
      edgeLabelBackground: readToken('--bg-page', '#ffffff'),
      fontFamily: readToken('--font-sans', 'system-ui, sans-serif')
    }
  }

  async function renderMermaid() {
    if (rendering) return

    const sourceBlocks = Array.from(
      document.querySelectorAll<HTMLElement>('[data-language="mermaid"]')
    )
      .map((shell) => ({
        shell,
        source: shell.querySelector('code')?.textContent?.trim() ?? ''
      }))
      .filter(({ source }) => source.length > 0)

    const existingDiagrams = Array.from(
      document.querySelectorAll<HTMLElement>('.mermaid-diagram[data-mermaid-source]')
    ).map((target) => ({
      source: target.dataset.mermaidSource ?? '',
      target
    }))

    if (!sourceBlocks.length && !existingDiagrams.length) return

    rendering = true

    try {
      const { default: mermaid } = await import('mermaid')
      mermaid.initialize({
        startOnLoad: false,
        securityLevel: 'strict',
        theme: 'base',
        themeVariables: getThemeVariables()
      })

      const renderOne = async (source: string, target: HTMLElement) => {
        const id = `ygrowly-mermaid-${diagramId++}`
        const { bindFunctions, svg } = await mermaid.render(id, source)
        target.innerHTML = svg
        target.dataset.mermaidSource = source
        bindFunctions?.(target)
      }

      for (const { shell, source } of sourceBlocks) {
        const target = document.createElement('figure')
        target.className = 'mermaid-diagram not-prose'
        const isEnPage = document.documentElement.lang === 'en'
        target.setAttribute('aria-label', isEnPage ? 'Architecture diagram' : '架构图')

        try {
          await renderOne(source, target)
          shell.replaceWith(target)
        } catch (error) {
          console.error('Unable to render Mermaid diagram', error)
          shell.setAttribute('data-mermaid-error', 'true')
        }
      }

      for (const { source, target } of existingDiagrams) {
        if (!source) continue

        try {
          await renderOne(source, target)
        } catch (error) {
          console.error('Unable to refresh Mermaid diagram', error)
        }
      }
    } finally {
      rendering = false
    }
  }

  const scheduleRender = () => {
    void renderMermaid()
  }

  document.addEventListener('astro:page-load', scheduleRender)
  window.addEventListener('ygrowly:theme-change', scheduleRender)

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', scheduleRender, { once: true })
  } else {
    scheduleRender()
  }
</script>

<style is:global>
  .mermaid-diagram {
    display: block;
    width: 100%;
    margin: 1.5rem 0 2rem;
    border: 1px solid hsl(var(--border) / 1);
    border-radius: var(--radius, 0.5rem);
    padding: 1rem;
    background: var(--bg-surface, hsl(var(--background) / 1));
    text-align: center;
  }

  .mermaid-diagram svg {
    display: block;
    width: min(100%, 66rem);
    height: auto;
    margin: 0 auto;
  }

  [data-mermaid-error='true'] {
    border-color: hsl(var(--destructive) / 0.5);
  }

  @media (max-width: 640px) {
    .mermaid-diagram {
      margin: 1.25rem 0 1.5rem;
      padding: 0.65rem;
    }
  }
</style>
