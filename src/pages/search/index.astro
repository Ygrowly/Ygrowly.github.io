---
import { Button } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import SiteSearch from '@/components/blog/SiteSearch.astro'

const meta = {
  description: '搜索整个博客的文章',
  noindex: true,
  title: '搜索'
}
---

<PageLayout {meta}>
  <Button title='← 返回博客' href='/blog' style='back' />
  <main class='mt-6 lg:mt-10'>
    <div id='content-header' class='animate'>
      <h1 class='mb-6 text-3xl font-medium'>搜索</h1>
    </div>

    <div id='content' class='animate'>
      <p>输入关键词搜索博客文章。</p>
      <SiteSearch lang='zh' />
    </div>
  </main>
</PageLayout>
