---
import { Image } from 'astro:assets'
import { getCollection } from 'astro:content'
import avatar from 'src/assets/avatar.png'

import { Quote } from 'astro-pure/advanced'
import { Button, Card, Icon, Label } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import Section from '@/components/home/Section.astro'
import SkillLayout from '@/components/home/SkillLayout.astro'
import JoJo from '@/components/mascot/JoJo'

export const prerender = true

const languages = ['Python', 'TypeScript', 'JavaScript', 'SQL']
const frontend = ['React', 'Next.js', 'Tailwind CSS', 'Vite']
const backend = ['FastAPI', 'Django', 'Node.js', 'PostgreSQL', 'Redis']
const ai = [
  'LLM/Transformer',
  'Agent Engineering',
  'RAG/Function Calling',
  'Multi-Agent Systems',
  'Prompt Engineering',
  'Fine-tuning'
]
const tools = ['Git', 'Docker', 'Bun', 'ESLint/Prettier', 'VS Code']

const MAX_POSTS = 5
const allPosts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, MAX_POSTS)

const MAX_NOTES = 4
const noteTypeLabels: Record<string, string> = {
  note: '笔记',
  snippet: '片段',
  draft: '草稿',
  idea: '想法',
  research: '研究',
  reference: '参考'
}
const allNotes = (await getCollection('notes')).filter((e) => !e.data.draft)
const latestNotes = allNotes
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, MAX_NOTES)
---

<PageLayout meta={{ title: 'Home' }} highlightColor='#659EB9'>
  <main class='flex w-full flex-col items-center'>
    <section
      class='animate mb-10 flex flex-col items-center gap-y-7 relative z-50'
      id='content-header'
    >
      <Image
        src={avatar}
        alt='profile'
        data-intro-target='avatar'
        class='h-28 w-auto rounded-full border p-1'
        loading='eager'
      />

      <div class='flex flex-col items-center gap-y-4'>
        <h1 class='text-3xl font-bold'>刘宇广 (Ygrowly)</h1>
        <p class='text-muted-foreground text-center'>
          AI 应用开发工程师 / Python 后端 / Agent Engineering
        </p>
        <div class='flex flex-wrap justify-center gap-x-7 gap-y-3'>
          <Label title='中国'>
            <Icon name='location' class='size-5' slot='icon' />
          </Label>
          <Label
            title='GitHub'
            as='a'
            href='https://github.com/Ygrowly'
            target='_blank'
            data-analytics-event='github_link_click'
            data-analytics-surface='home_profile'
            data-analytics-target='profile'
          >
            <Icon name='github' class='size-5' slot='icon' />
          </Label>
        </div>
      </div>

      {/* Connect Me! */}
      <div class='flex flex-row gap-3'>
        <a
          href='/contact'
          class='flex flex-row items-center gap-x-3 rounded-full border bg-background px-4 py-2 text-sm shadow-sm transition-shadow hover:shadow-md'
        >
          <span class='relative flex items-center justify-center'>
            <span
              class='absolute size-2 animate-ping rounded-full border border-green-400 bg-green-400 opacity-75'
            ></span>
            <span class='size-2 rounded-full bg-green-400'></span>
          </span>
          <p class='font-medium text-muted-foreground'>Connect Me!</p>
        </a>
      </div>
    </section>

    <div
      id='content'
      class='animate relative z-0 flex w-full min-w-0 max-w-full flex-col gap-y-10 md:w-4/5 lg:w-5/6'
    >
      <div class='-mt-2'></div>
      <Section title='个人定位'>
        <p class='text-muted-foreground'>
          专注将 AI、数据系统与企业业务结合，构建可靠、可观测、可持续迭代的 AI 应用。
        </p>
        <p class='text-muted-foreground'>
          我是数据科学与大数据技术专业 2027 届学生，主攻 AI 应用开发方向。关注 Agent
          Engineering、LLM 应用架构、 以及如何将最新的 AI 研究落地为可服务、可运维的产品系统。
          相信技术应该为人所用，好的工程能让 AI 更可靠、更透明、更有价值。
        </p>
        <Button title='更多关于我' class='w-fit self-end' href='/about' style='ahead' />
      </Section>
      
      <Section title='教育背景'>
        <Card
          as='div'
          heading='数据科学与大数据技术'
          subheading='2023-2027（预计毕业）'
          date='本科在读'
        >
          <ul class='ms-4 list-disc text-muted-foreground'>
            <li>主修方向：人工智能、大数据分析、机器学习</li>
            <li>相关课程：Python 编程、数据结构与算法、数据库原理、深度学习导论</li>
          </ul>
        </Card>
      </Section>

      <Section title='技术能力'>
        <SkillLayout title='编程语言' skills={languages} />
        <SkillLayout title='前端' skills={frontend} />
        <SkillLayout title='后端' skills={backend} />
        <SkillLayout title='AI/Agent' skills={ai} />
        <SkillLayout title='工具' skills={tools} />
      </Section>

      <Section title='最新文章'>
        <p class='text-muted-foreground'>记录技术思考、项目总结和学习笔记。</p>
        {
          allPosts.length > 0 && (
            <ul class='flex flex-col gap-y-1.5 sm:gap-y-2'>
              {allPosts.map((p) => (
                <li class='post-preview group/card flex flex-col relative rounded-2xl border bg-background transition-colors ease-in-out px-5 py-2.5 hover:bg-muted'>
                  <a
                    class='group/link w-full flex flex-col sm:flex-row transition-all hover:text-primary'
                    href={`/blog/${p.id}`}
                    data-astro-prefetch
                  >
                    <span class='min-w-[95px] py-1 text-xs text-muted-foreground'>
                      {new Date(p.data.publishDate).toLocaleDateString('zh-CN', {
                        month: 'short',
                        day: 'numeric'
                      })}
                    </span>
                    <div class='z-10 flex-grow'>
                      <div class='flex justify-between'>
                        <div>{p.data.title}</div>
                        <svg
                          xmlns='http://www.w3.org/2000/svg'
                          width='16'
                          height='16'
                          viewBox='0 0 24 24'
                          fill='none'
                          stroke-width='2.5'
                          stroke-linecap='round'
                          stroke-linejoin='round'
                          class='my-1 stroke-muted-foreground group-hover/link:stroke-primary'
                        >
                          <line
                            x1='5'
                            y1='12'
                            x2='19'
                            y2='12'
                            class='translate-x-4 scale-x-0 transition-all duration-300 ease-in-out group-hover/link:translate-x-1 group-hover/link:scale-x-100'
                          />
                          <polyline
                            points='12 5 19 12 12 19'
                            class='translate-x-0 transition-all duration-300 ease-in-out group-hover/link:translate-x-1'
                          />
                        </svg>
                      </div>
                    </div>
                  </a>
                </li>
              ))}
            </ul>
          )
        }
        <Button title='查看更多文章' class='w-fit self-end' href='/blog' style='ahead' />
      </Section>

      <Section title='最新笔记'>
        <p class='text-muted-foreground'>零散的思考、研究卡片和技术片段。</p>
        {
          latestNotes.length > 0 && (
            <ul class='flex flex-col gap-y-1.5 sm:gap-y-2'>
              {latestNotes.map((note) => (
                <li class='post-preview group/card flex flex-col relative rounded-2xl border bg-background transition-colors ease-in-out px-5 py-2.5 hover:bg-muted'>
                  <a
                    class='group/link w-full flex flex-col sm:flex-row transition-all hover:text-primary'
                    href={`/notes/${note.id}`}
                    data-astro-prefetch
                  >
                    <span class='min-w-[95px] py-1 text-xs text-muted-foreground'>
                      {noteTypeLabels[note.data.type] || note.data.type}
                    </span>
                    <div class='z-10 flex-grow'>
                      <div class='flex justify-between'>
                        <div>{note.data.title}</div>
                        <svg
                          xmlns='http://www.w3.org/2000/svg'
                          width='16'
                          height='16'
                          viewBox='0 0 24 24'
                          fill='none'
                          stroke-width='2.5'
                          stroke-linecap='round'
                          stroke-linejoin='round'
                          class='my-1 stroke-muted-foreground group-hover/link:stroke-primary'
                        >
                          <line
                            x1='5'
                            y1='12'
                            x2='19'
                            y2='12'
                            class='translate-x-4 scale-x-0 transition-all duration-300 ease-in-out group-hover/link:translate-x-1 group-hover/link:scale-x-100'
                          />
                          <polyline
                            points='12 5 19 12 12 19'
                            class='translate-x-0 transition-all duration-300 ease-in-out group-hover/link:translate-x-1'
                          />
                        </svg>
                      </div>
                    </div>
                  </a>
                </li>
              ))}
            </ul>
          )
        }
        <Button title='查看更多笔记' class='w-fit self-end' href='/notes' style='ahead' />
      </Section>

      <Section title='实习经历'>
        <p class='text-muted-foreground'>期待在 AI 应用开发方向的实习机会。</p>
        <Card
          as='div'
          heading='寻找实习机会'
          subheading='AI 应用开发 / Python 后端 / Agent Engineering'
          date='2025年夏季'
        >
          <ul class='ms-4 list-disc text-muted-foreground'>
            <li>期望方向：将 LLM/Agent 技术应用于企业级产品</li>
            <li>技术栈偏好：Python 后端、AI 工程、可观测性工具链</li>
            <li>关注领域：Agent 系统、RAG 应用、多模态 AI 产品</li>
          </ul>
        </Card>
      </Section>

      <Section title='精选项目'>
        <p class='text-muted-foreground'>正在准备中的个人与开源项目。</p>
        <Card as='div' heading='项目筹备中' subheading='AI 应用开发相关项目'>
          <ul class='ms-4 list-disc text-muted-foreground'>
            <li>计划开发：基于 Agent 的 AI 助手应用</li>
            <li>技术栈：FastAPI + React + PostgreSQL + 主流 LLM API</li>
            <li>目标：构建可观测、可迭代的企业级 AI 应用样板</li>
          </ul>
        </Card>
      </Section>

      <Section title='联系方式'>
        <p class='text-muted-foreground'>欢迎交流 AI 应用开发、技术合作或实习机会。</p>
        <div class='flex flex-col gap-4'>
          <Card
            as='a'
            href='mailto:lyg3044@qq.com'
            heading='邮箱'
            subheading='lyg3044@qq.com'
            class='hover:bg-muted transition-colors'
          />
          <Card
            as='a'
            href='https://github.com/Ygrowly'
            target='_blank'
            heading='GitHub'
            subheading='@Ygrowly'
            class='hover:bg-muted transition-colors'
          />
        </div>
        <Button title='详细联系方式' class='w-fit self-end' href='/contact' style='ahead' />
      </Section>
    </div>
    <Quote class='mt-12' />
  </main>

  {/* JoJo mascot — floating companion bottom-right (hidden on mobile) */}
  <div id='home-jojo' class='pointer-events-none fixed bottom-6 end-6 z-40 hidden md:block'>
    <div class='pointer-events-auto'>
      <JoJo client:load size='md' quipPool='idle' />
    </div>
  </div>
</PageLayout>
