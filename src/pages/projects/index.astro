---
import PageLayout from '@/layouts/CommonPage.astro'
import ProjectSection from '@/components/projects/ProjectSection.astro'

const headings = [
  { depth: 2, slug: 'systems', text: 'Systems' },
  { depth: 2, slug: 'open-source', text: 'Open Source' }
]
---

<PageLayout title='Projects' {headings} info={{ slug: '/projects', hideComment: true }}>
  <p>
    这里是我正在构建和维护的项目。当前重点是把 AI Agent 与数据系统落到真实业务里 ——
    能运行、可观测、可持续迭代。
  </p>

  <h2 id='systems'>Systems</h2>
  <ProjectSection
    analyticsSection='systems'
    project={[
      {
        id: 'energyops_agent',
        name: 'EnergyOps Agent',
        description:
          '企业能耗数据平台：从原始累计读数到可信统计、异常诊断与 Agent 工具调用（raw → interval → hourly → daily），含调度自愈与告警闭环。',
        links: []
      },
      {
        id: 'paytrace',
        name: 'PayTrace（Building · 持续开发中）',
        description: '跨境支付异常归因与诊断 Agent，独立设计的系统与评测实验场。',
        links: []
      }
    ]}
  />

  <h2 id='open-source'>Open Source</h2>
  <p>开源项目整理中，欢迎先到 <a href='https://github.com/Ygrowly' target='_blank'>GitHub</a> 围观。</p>
</PageLayout>
