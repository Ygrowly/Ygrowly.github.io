---
import PageLayout from '@/layouts/CommonPage.astro'
import ProjectSection from '@/components/projects/ProjectSection.astro'

const headings = [{ depth: 2, slug: 'systems', text: 'Systems' }]
---

<PageLayout title='Projects' {headings} info={{ slug: '/projects', hideComment: true }}>
  <p>
    这里是我正在构建和维护的项目。当前重点是把 AI Agent 与数据系统落到真实业务里 ——
    能运行、可观测、可持续迭代。公开仓库的图标可以直接点开代码；实习所在公司的内部系统不公开，案例页里写了为什么。
  </p>

  <h2 id='systems'>Systems</h2>
  <ProjectSection
    analyticsSection='systems'
    project={[
      {
        id: 'energyops_agent',
        name: 'EnergyOps Agent',
        description:
          '企业能耗数据平台：从原始累计读数到可信统计、异常诊断与 Agent 工具调用（raw → interval → hourly → daily），含调度自愈与告警闭环。',
        links: [{ type: 'doc', href: '/projects/energyops-agent' }]
      },
      {
        id: 'ai_bi_platform',
        name: '数驭穹图 AI BI',
        description: '自然语言问数有来源、有口径、可验证：语义层与领域路由、查询安全与证据绑定进入同一工作流。',
        links: [{ type: 'doc', href: '/projects/ai-bi-platform' }]
      },
      {
        id: 'rulearena',
        name: 'RuleArena',
        description:
          '电商规则对抗验证与发布门禁平台：规则编译为人工确认的可执行契约，受控 Agent 对抗搜索、干净环境重放、确定性 Oracle 裁决，沉淀可回归最小反例。',
        links: [
          { type: 'doc', href: '/projects/rulearena' },
          { type: 'github', href: 'https://github.com/Ygrowly/RuleArena' }
        ]
      },
      {
        id: 'paytrace',
        name: 'PayTrace',
        description:
          '证据驱动的支付转化异常归因与诊断 Agent：确定性损失拆解、Hook 链治理的 Diagnostic Harness、证据契约与故障注入评测（模拟数据）。',
        links: [
          { type: 'doc', href: '/projects/paytrace' },
          { type: 'github', href: 'https://github.com/Ygrowly/PayTrace' }
        ]
      },
      {
        id: 'ovanta',
        name: 'Ovanta',
        description:
          '跨区域签证、移民与海外身份自助申请平台：结构化内容系统、区域化登录支付与会员权益，已上线。',
        links: [
          { type: 'doc', href: '/projects/ovanta' },
          { type: 'site', href: 'https://www.ovanta.cn/' }
        ]
      }
    ]}
  />
</PageLayout>
