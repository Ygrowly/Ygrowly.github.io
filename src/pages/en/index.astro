---
import { Image } from 'astro:assets'
import { getCollection } from 'astro:content'
import avatar from 'src/assets/avatar.png'

import { Quote } from 'astro-pure/advanced'
import { Button, Card, Icon, Label } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import PostPreviewEn from '@/components/blog/PostPreviewEn.astro'
import Section from '@/components/home/Section.astro'
import SiteStats from '@/components/home/SiteStats.astro'
import SkillLayout from '@/components/home/SkillLayout.astro'
import JoJo from '@/components/mascot/JoJo'
import Terminal from '@/components/terminal/Terminal.astro'

export const prerender = true

const languages = ['Python', 'TypeScript', 'JavaScript', 'SQL']
const frontend = ['React', 'Next.js', 'Tailwind CSS', 'Vite']
const backend = ['FastAPI', 'Django', 'Node.js', 'PostgreSQL', 'Redis']
const ai = [
  'LLM/Transformer',
  'Agent Engineering',
  'RAG/Function Calling',
  'Multi-Agent Systems',
  'Prompt Engineering',
  'Fine-tuning'
]
const tools = ['Git', 'Docker', 'Bun', 'ESLint/Prettier', 'VS Code']

const MAX_POSTS = 5
const allPostsByDate = (await getCollection('blogEn'))
  .filter((p) => (import.meta.env.PROD ? !p.data.draft : true))
  .sort(
    (a, b) =>
      +new Date(b.data.updatedDate ?? b.data.publishDate) -
      +new Date(a.data.updatedDate ?? a.data.publishDate)
  )
  .slice(0, MAX_POSTS)

const MAX_NOTES = 4
const noteTypeLabels: Record<string, string> = {
  note: 'Note',
  snippet: 'Snippet',
  draft: 'Draft',
  idea: 'Idea',
  research: 'Research',
  reference: 'Reference'
}
const latestNotes = (await getCollection('notesEn'))
  .filter((e) => !e.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, MAX_NOTES)
---

<PageLayout meta={{ title: 'Home' }} highlightColor='#659EB9'>
  <main class='flex w-full flex-col items-center'>
    <section
      class='animate mb-10 flex flex-col items-center gap-y-7 relative z-50'
      id='content-header'
    >
      <Image
        src={avatar}
        alt='profile'
        data-intro-target='avatar'
        class='h-28 w-auto rounded-full border p-1'
        loading='eager'
      />

      <div class='flex flex-col items-center gap-y-4'>
        <h1 class='text-3xl font-bold'>Yuguang Liu (Ygrowly)</h1>
        <p class='text-muted-foreground text-center'>
          AI Application Developer / Python Backend / Agent Engineering
        </p>
        <div class='flex flex-wrap justify-center gap-x-7 gap-y-3'>
          <Label title='China'>
            <Icon name='location' class='size-5' slot='icon' />
          </Label>
          <Label
            title='GitHub'
            as='a'
            href='https://github.com/Ygrowly'
            target='_blank'
            data-analytics-event='github_link_click'
            data-analytics-surface='home_profile'
            data-analytics-target='profile'
          >
            <Icon name='github' class='size-5' slot='icon' />
          </Label>
        </div>
      </div>

      {/* Connect Me! */}
      <div class='flex flex-row gap-3'>
        <a
          href='/en/contact'
          class='flex flex-row items-center gap-x-3 rounded-full border bg-background px-4 py-2 text-sm shadow-sm transition-shadow hover:shadow-md'
        >
          <span class='relative flex items-center justify-center'>
            <span
              class='absolute size-2 animate-ping rounded-full border border-green-400 bg-green-400 opacity-75'
            ></span>
            <span class='size-2 rounded-full bg-green-400'></span>
          </span>
          <p class='font-medium text-muted-foreground'>Connect Me!</p>
        </a>
      </div>
    </section>

    <div
      id='content'
      class='animate relative z-0 flex w-full min-w-0 max-w-full flex-col gap-y-10 md:w-4/5 lg:w-5/6'
    >
      <div class='-mt-2'>
        <Terminal />
      </div>
      <Section title='About'>
        <p class='text-muted-foreground'>
          Focused on combining AI, data systems and business workflows — building AI applications
          that are reliable, observable and continuously iterable.
        </p>
        <p class='text-muted-foreground'>
          I'm a Data Science undergrad (class of 2027) heading toward AI application development. I
          care about agent engineering, LLM application architecture, and how to turn the latest AI
          research into products that can be served and operated in the real world.
        </p>
        <Button title='More about me' class='w-fit self-end' href='/en/about' style='ahead' />
      </Section>

      {
        allPostsByDate.length > 0 && (
          <Section title='Blog'>
            <ul class='flex flex-col gap-y-1.5 sm:gap-y-2'>
              {allPostsByDate.map((p) => (
                <PostPreviewEn post={p} />
              ))}
            </ul>
            <Button title='More blogs' class='w-fit self-end' href='/en/blog' style='ahead' />
          </Section>
        )
      }

      {
        latestNotes.length > 0 && (
          <Section title='Notes'>
            <ul class='flex flex-col gap-y-1.5 sm:gap-y-2'>
              {latestNotes.map((note) => (
                <li class='post-preview group/card flex flex-col relative rounded-2xl border bg-background transition-colors ease-in-out px-5 py-2.5 hover:bg-muted'>
                  <a
                    class='group/link w-full flex flex-col sm:flex-row transition-all hover:text-primary'
                    href={`/en/notes/${note.data.translationKey}`}
                    data-astro-prefetch
                  >
                    <span class='min-w-[95px] py-1 text-xs text-muted-foreground'>
                      {noteTypeLabels[note.data.type] || note.data.type}
                    </span>
                    <div class='z-10 flex-grow'>
                      <div class='flex justify-between'>
                        <div>{note.data.title}</div>
                        <svg
                          xmlns='http://www.w3.org/2000/svg'
                          width='16'
                          height='16'
                          viewBox='0 0 24 24'
                          fill='none'
                          stroke-width='2.5'
                          stroke-linecap='round'
                          stroke-linejoin='round'
                          class='my-1 stroke-muted-foreground group-hover/link:stroke-primary'
                        >
                          <line
                            x1='5'
                            y1='12'
                            x2='19'
                            y2='12'
                            class='translate-x-4 scale-x-0 transition-all duration-300 ease-in-out group-hover/link:translate-x-1 group-hover/link:scale-x-100'
                          />
                          <polyline
                            points='12 5 19 12 12 19'
                            class='translate-x-0 transition-all duration-300 ease-in-out group-hover/link:translate-x-1'
                          />
                        </svg>
                      </div>
                    </div>
                  </a>
                </li>
              ))}
            </ul>
            <Button title='More notes' class='w-fit self-end' href='/en/notes' style='ahead' />
          </Section>
        )
      }

      <Section title='Projects'>
        <p class='text-muted-foreground'>Systems I'm building right now.</p>
        <Card
          as='div'
          heading='EnergyOps Agent'
          subheading='Enterprise energy data platform: trusted statistics, anomaly diagnosis and agent tool calls'
        >
          <ul class='ms-4 list-disc text-muted-foreground'>
            <li>Data pipeline: raw → interval → hourly → daily</li>
            <li>Self-healing scheduling and a closed alerting loop</li>
          </ul>
        </Card>
        <Card
          as='div'
          heading='PayTrace (Building)'
          subheading='Cross-border payment anomaly attribution and diagnosis agent'
        >
          <ul class='ms-4 list-disc text-muted-foreground'>
            <li>Independently designed system and evaluation playground</li>
          </ul>
        </Card>
        <Button title='More projects' class='w-fit self-end' href='/en/projects' style='ahead' />
      </Section>

      <Section title='Education'>
        <Card
          as='div'
          heading='Data Science and Big Data Technology'
          subheading='B.Eng., expected 2027'
          date='Undergraduate'
        />
      </Section>

      <Section title='Skills'>
        <SkillLayout title='Languages' skills={languages} />
        <SkillLayout title='Frontend' skills={frontend} />
        <SkillLayout title='Backend' skills={backend} />
        <SkillLayout title='AI & Agent' skills={ai} />
        <SkillLayout title='Tools' skills={tools} />
      </Section>

      <SiteStats lang='en' />
    </div>
    <Quote class='mt-12' />
  </main>

  {/* JoJo mascot — floating companion bottom-right (hidden on mobile) */}
  <div id='home-jojo' class='pointer-events-none fixed bottom-6 end-6 z-40 hidden md:block'>
    <div class='pointer-events-auto'>
      <JoJo client:load size='md' quipPool='idle' />
    </div>
  </div>
</PageLayout>
