---
import PageLayout from '@/layouts/CommonPage.astro'
import ProjectSection from '@/components/projects/ProjectSection.astro'

const headings = [
  { depth: 2, slug: 'systems', text: 'Systems' },
  { depth: 2, slug: 'open-source', text: 'Open Source' }
]
---

<PageLayout title='Projects' {headings} info={{ slug: '/en/projects', hideComment: true }}>
  <p>
    Projects I'm building and maintaining. The current focus: putting AI agents and data systems
    into real business workflows — running, observable, and continuously iterable.
  </p>

  <h2 id='systems'>Systems</h2>
  <ProjectSection
    analyticsSection='systems'
    project={[
      {
        id: 'energyops_agent',
        name: 'EnergyOps Agent',
        description:
          'Enterprise energy data platform: from raw cumulative readings to trusted statistics, anomaly diagnosis and agent tool calls (raw → interval → hourly → daily), with self-healing scheduling and an alerting loop.',
        links: [{ type: 'doc', href: '/en/projects/energyops-agent' }]
      },
      {
        id: 'ai_bi_platform',
        name: 'DataSphere AI BI',
        description:
          'Natural-language analytics with sources, definitions, and verifiable results: a semantic layer with domain routing, query safety, and evidence binding in one workflow.',
        links: [{ type: 'doc', href: '/en/projects/ai-bi-platform' }]
      },
      {
        id: 'rulearena',
        name: 'RuleArena',
        description:
          'Adversarial verification and release gates for e-commerce rule changes: rules compile into human-confirmed contracts, a governed agent searches high-risk sequences, a clean environment replays them, and a deterministic oracle adjudicates.',
        links: [{ type: 'doc', href: '/en/projects/rulearena' }]
      },
      {
        id: 'paytrace',
        name: 'PayTrace',
        description:
          'Evidence-driven payment conversion anomaly attribution and diagnosis agent: deterministic loss attribution, a Hook-governed Diagnostic Harness, an evidence contract, and fault-injected evaluation (simulated data).',
        links: [{ type: 'doc', href: '/en/projects/paytrace' }]
      },
      {
        id: 'ovanta',
        name: 'Ovanta',
        description:
          'Cross-region self-service platform for visas, immigration, and overseas identity: structured content, regional login and payments, and membership entitlements. Live in production.',
        links: [
          { type: 'doc', href: '/en/projects/ovanta' },
          { type: 'site', href: 'https://www.ovanta.cn/' }
        ]
      }
    ]}
  />

  <h2 id='open-source'>Open Source</h2>
  <p>
    Open-source work is being organized — meanwhile, feel free to browse my
    <a href='https://github.com/Ygrowly' target='_blank'>GitHub</a>.
  </p>
</PageLayout>
