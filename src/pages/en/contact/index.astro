---
import PageLayout from '@/layouts/CommonPage.astro'
import ContactQR from '@/components/contact/ContactQR.astro'
import qq from '@/assets/qq-contact.jpg'
import wechat from '@/assets/wechat-contact.jpg'

const headings = [
  { depth: 2, slug: 'how-to-reach', text: 'How to reach me' },
  { depth: 2, slug: 'before-you-add', text: 'Before you add me' }
]
---

<PageLayout title='Contact' {headings} info='/en/contact'>
  <p>
    Happy to chat — AI application development, internship or collaboration opportunities, or tech
    talk in general. I'm slow to reply, but I do reply.
  </p>

  <h2 id='how-to-reach'>How to reach me</h2>
  <p>Tap or hover over a card to reveal the QR code. Email also works: lyg3044@qq.com.</p>
  <ContactQR
    class='my-6'
    items={[
      {
        name: 'WeChat',
        hint: 'Tap/hover to reveal QR',
        image: wechat,
        methodName: 'wechat',
        note: 'Please add a note, e.g. "agent development" or "internship opportunity".'
      },
      {
        name: 'QQ',
        hint: 'Tap/hover to reveal QR',
        image: qq,
        methodName: 'qq',
        note: 'Casual chats and tech discussions are welcome.'
      }
    ]}
  />

  <h2 id='before-you-add'>Before you add me</h2>
  <ul>
    <li>
      <strong>Tell me why you're reaching out</strong>. One sentence is enough — e.g. "want to chat
      about agent development" or "blog collab". Friend requests with no note will likely be
      ignored.
    </li>
    <li>
      <strong>Business / promotion / recruiting</strong>: please share the context and what kind of
      collaboration you have in mind upfront, instead of opening with "hi".
    </li>
  </ul>
</PageLayout>
