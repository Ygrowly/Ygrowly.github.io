---
import { Spoiler, Timeline } from 'astro-pure/user'
import PageLayout from '@/layouts/CommonPage.astro'
import Substats from '@/components/about/Substats.astro'
import ToolSection from '@/components/about/ToolSection.astro'
import hermesIcon from '@/assets/tools/hermes.png'
import pencilIcon from '@/assets/tools/pencil.png'

const headings = [
  { depth: 2, slug: 'hobbies', text: 'Hobbies' },
  { depth: 2, slug: 'social-networks', text: 'Social Networks' },
  { depth: 2, slug: 'tools', text: 'Tools' },
  { depth: 2, slug: 'about-blog', text: 'About Blog' }
]
---

<PageLayout title='About' {headings} info='/about'>
  <p>Developer</p>
  <p>
    I'm Ygrowly (Liu Yuguang), a Data Science undergraduate in the class of 2027, focused on AI
    application development. My work is about putting AI agents into real business systems —
    Python backends, data pipelines and LLM tooling that keeps running and iterating after the
    demo.
  </p>
  <p>
    My motto: Build systems that outlive the demo. <Spoiler />
  </p>

  {/* hobbies */}
  <h2 id='hobbies'>Hobbies</h2>
  <ul>
    <li>
      <strong>Agent engineering</strong> — I enjoy everything outside the model itself: tool calls,
      context management, self-healing schedulers and alerting loops — turning agents from demos
      into systems that run for real.
    </li>
    <li>
      <strong>Data systems</strong> — raw → interval → hourly → daily pipelines, observability and
      reliability fallbacks. It's what I work with every day on EnergyOps Agent.
    </li>
    <li>
      <strong>Open Source</strong> — Working toward becoming an active open-source contributor, learning
      and growing through code and community.
    </li>
  </ul>

  {/* social-networks */}
  <h2 id='social-networks'>Social Networks</h2>
  <p>Find me around the web — I'm most active on GitHub.</p>
  <Substats
    stats={[
      {
        platform: 'GitHub',
        icon: 'github',
        link: 'https://github.com/Ygrowly',
        text: 'followers',
        api: 'github/Ygrowly'
      }
    ]}
  />

  {/* tools */}
