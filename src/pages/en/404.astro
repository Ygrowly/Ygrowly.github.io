---
import { Button } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'

export const prerender = true

const meta = {
  description: 'Page not found',
  noindex: true,
  title: '404'
}
---

<PageLayout {meta}>
  <main class='px-4 py-10 text-center sm:px-6 lg:px-8'>
    <h1 class='block text-7xl font-bold sm:text-9xl'>404</h1>
    <p class='mt-3 text-muted-foreground'>Page not found.</p>
    <p class='text-lg'>This page may have been moved or deleted.</p>
    <Button title='Back to home' href='/en' style='ahead' class='mt-5' />
  </main>
</PageLayout>
