---
import PageLayout from '@/layouts/CommonPage.astro'
import { homeContent, projectHref } from '@/data/home'

const { experience, lab } = homeContent.zh

const headings = [
  { depth: 2, slug: 'internships', text: 'Internships' },
  { depth: 2, slug: 'lab-open-source', text: 'Lab & Open Source' }
]
---

<PageLayout title='Experience' {headings} info={{ slug: '/experience', hideComment: true }}>
  <p>
    三段实习，按时间倒序。每段先说我在团队里的位置和负责范围，再给技术栈；设计上的取舍、边界和还没解决的问题都放在各自的完整案例里，这里只放结论。
  </p>

  <h2 id='internships'>Internships</h2>
  <div class='experience-entries'>
    {
      experience.items.map((item) => (
        <article class='experience-entry'>
          <p class='experience-entry__period'>{item.period}</p>
          <h3 class='experience-entry__company'>{item.company}</h3>
          <p class='experience-entry__role'>{item.role}</p>
          <p class='experience-entry__scope'>{item.scope}</p>
          <p>{item.contribution}</p>
          <p class='experience-entry__focus'>{item.focus}</p>
          {item.stack && <p class='experience-entry__stack'>{item.stack}</p>}
          <a class='experience-entry__case' href={projectHref(item.caseSlug, 'zh')}>
            {experience.caseLink}
          </a>
        </article>
      ))
    }
  </div>

  <h2 id='lab-open-source'>Lab & Open Source</h2>
  <ul>
    {
      lab.items.map((item) => (
        <li>
          <a
            href={item.href}
            target={item.external ? '_blank' : undefined}
            rel={item.external ? 'noopener noreferrer' : undefined}
          >
            {item.name}
          </a>
          <span class='experience-lab__status'>{item.status}</span> — {item.description}
        </li>
      ))
    }
  </ul>
</PageLayout>

<style>
  .experience-entries {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .experience-entry {
    border-inline-start: 2px solid hsl(var(--border) / var(--un-border-opacity, 1));
    padding-inline-start: 1rem;
  }

  .experience-entry__period {
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    opacity: 0.7;
    margin-bottom: 0.25rem;
  }

  .experience-entry__company {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 600;
  }

  .experience-entry__role {
    margin-top: 0.125rem;
    font-weight: 500;
    opacity: 0.85;
  }

  .experience-entry__focus {
    font-size: 0.9375rem;
    opacity: 0.75;
  }

  /* Where I sat and what I owned — the part a role page owes a reader, and the
     part a case page (which is about the system, not the job) never states. */
  .experience-entry__scope {
    opacity: 0.9;
  }

  .experience-entry__stack {
    margin-top: 0.5rem;
    color: var(--signal-accent);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  .experience-entry__case {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    margin-top: 0.25rem;
    color: var(--signal-accent);
    font-size: 0.9375rem;
  }

  .experience-entry__case:hover {
    text-decoration: underline;
  }

  .experience-lab__status {
    margin-inline-start: 0.375rem;
    font-size: 0.75rem;
    border: 1px solid hsl(var(--border) / var(--un-border-opacity, 1));
    border-radius: 9999px;
    padding: 0.0625rem 0.5rem;
    vertical-align: middle;
  }
</style>
